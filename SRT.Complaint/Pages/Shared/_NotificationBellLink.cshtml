@model SRT.Complaint.Pages.Staff.NotificationBellVm
<a id="notif-bell" href="@Model.LinkUrl"
   hx-get="@Url.Page("/Staff/NotificationBadge")" hx-trigger="every 20s" hx-target="#notif-bell" hx-swap="outerHTML"
   class="relative w-9 h-9 rounded-xl hover:bg-gray-100 flex items-center justify-center transition shrink-0"
   aria-label="@(Model.Count > 0 ? $"มีเรื่องใหม่รอดำเนินการ {Model.Count} เรื่อง" : "ไม่มีเรื่องใหม่รอดำเนินการ")">
    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
    </svg>
    @if (Model.Count > 0)
    {
        <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center">
            @(Model.Count > 99 ? "99+" : Model.Count.ToString())
        </span>
    }
</a>
