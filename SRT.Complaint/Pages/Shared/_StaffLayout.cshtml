@using System.Security.Claims
@inject SRT.Complaint.Services.IComplaintService ComplaintServiceForBell
@inject SRT.Complaint.Services.ICorruptionService CorruptionServiceForBell
@{
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var userName = User.FindFirstValue("FullName") ?? User.Identity?.Name ?? "เจ้าหน้าที่";
    var empCode  = User.FindFirstValue("EmployeeCode") ?? "";

    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    bool IsActive(string prefix) => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    var notificationBell = await SRT.Complaint.Pages.Staff.NotificationBadgeModel.BuildAsync(
        User, ComplaintServiceForBell, CorruptionServiceForBell);
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ระบบจัดการ รฟท.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="staff-shell flowbite-shell h-screen flex overflow-hidden bg-slate-50 font-thai antialiased">

    <!-- Skip navigation — WCAG 2.4.1 -->
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[9999]
              focus:bg-srt-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg
              focus:text-sm focus:font-semibold focus:shadow-lg">
        ข้ามไปยังเนื้อหาหลัก
    </a>

    <!-- ═══ SIDEBAR ═══ -->
    <aside id="sidebar"
           class="w-[240px] max-w-[calc(100vw-3rem)] bg-white flex flex-col shrink-0 border-r border-slate-200
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform duration-300
                  motion-reduce:transition-none lg:static lg:translate-x-0 scrollbar-thin"
           aria-label="เมนูระบบ"
           aria-hidden="true"
           inert>

        <!-- Logo -->
        <div class="flex items-center gap-2 px-4 h-16 border-b border-slate-200 shrink-0">
            <img src="~/images/srt-logo.png"
                 alt="การรถไฟแห่งประเทศไทย"
                 class="h-10 w-auto object-contain shrink-0" />
            <div class="text-slate-600 text-[14px] leading-tight min-w-0">
                <div>ระบบจัดการ</div>
                <div>เรื่องร้องเรียน</div>
            </div>
            <button type="button"
                    id="sidebar-close"
                    onclick="setSidebarOpen(false, true)"
                    class="ml-auto inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-srt-navy lg:hidden"
                    aria-controls="sidebar"
                    aria-label="ปิดเมนูระบบ">
                <svg class="h-5 w-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- User info -->
        <div class="px-4 py-4 border-b border-slate-200 shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center shrink-0">
                    <svg class="h-5 w-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.1a7.5 7.5 0 0115 0 17.9 17.9 0 01-15 0z" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="font-semibold text-slate-900 text-sm truncate">@userName</div>
                    <div class="text-[11px] text-slate-500">
                        @(userRole switch {
                            "GeneralOfficer"    => "เจ้าหน้าที่รับเรื่อง",
                            "CorruptionOfficer" => "เจ้าหน้าที่ทุจริต",
                            "SuperAdmin"        => "ผู้ดูแลระบบ",
                            _                  => userRole
                        })
                        @if (!string.IsNullOrEmpty(empCode))
                        {
                            <span> · @empCode</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto py-3 px-3 scrollbar-thin" aria-label="เมนูหลัก">

            @if (userRole is "GeneralOfficer" or "SuperAdmin")
            {
                <div class="sidebar-section" data-section-id="general">
                <button type="button" class="section-title-btn" onclick="toggleSidebarSection('general')" aria-expanded="true" aria-controls="section-general">
                    <span>เรื่องทั่วไป</span>
                    <svg class="section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="section-general" class="sidebar-section-body"><div>
                <a asp-page="/Staff/Dashboard"
                   class="sidebar-link @(IsActive("/Staff/Dashboard") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10-3a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z" />
                    </svg>
                    แดชบอร์ด
                </a>
                <a asp-page="/Staff/Queue"
                   class="sidebar-link @(IsActive("/Staff/Queue") || IsActive("/Staff/CaseDetail") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    คิวเรื่องร้องเรียน
                </a>
                <a asp-page="/Staff/CreateComplaint"
                   class="sidebar-link @(IsActive("/Staff/CreateComplaint") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 4v16m8-8H4" />
                    </svg>
                    สร้างเรื่องร้องเรียน
                </a>
                </div></div>
                </div>
            }

            @if (userRole is "CorruptionOfficer" or "SuperAdmin")
            {
                <div class="sidebar-section" data-section-id="corruption">
                <button type="button" class="section-title-btn" onclick="toggleSidebarSection('corruption')" aria-expanded="true" aria-controls="section-corruption">
                    <span>เรื่องทุจริต</span>
                    <svg class="section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="section-corruption" class="sidebar-section-body"><div>
                <a asp-page="/Corruption/Dashboard"
                   class="sidebar-link @(IsActive("/Corruption/Dashboard") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    แดชบอร์ดทุจริต
                </a>
                <a asp-page="/Corruption/Queue"
                   class="sidebar-link @(IsActive("/Corruption/Queue") || IsActive("/Corruption/CaseDetail") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    คิวเรื่องทุจริต
                </a>
                </div></div>
                </div>
            }

            @if (userRole == "SuperAdmin")
            {
                <div class="sidebar-section" data-section-id="admin">
                <button type="button" class="section-title-btn" onclick="toggleSidebarSection('admin')" aria-expanded="true" aria-controls="section-admin">
                    <span>ผู้ดูแลระบบ</span>
                    <svg class="section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="section-admin" class="sidebar-section-body"><div>

                <!-- ── ภาพรวม ── -->
                <p class="section-subtitle">ภาพรวม</p>
                <a asp-page="/Admin/Dashboard"
                   class="sidebar-link @(IsActive("/Admin/Dashboard") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                    </svg>
                    ภาพรวมระบบ
                </a>
                <a asp-page="/Admin/Reports"
                   class="sidebar-link @(IsActive("/Admin/Reports") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    รายงาน
                </a>

                <!-- ── ตั้งค่าระบบ ── -->
                <p class="section-subtitle">ตั้งค่าระบบ</p>
                <a asp-page="/Admin/Users"
                   class="sidebar-link @(IsActive("/Admin/Users") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    จัดการเจ้าหน้าที่
                </a>
                <a asp-page="/Admin/Categories"
                   class="sidebar-link @(IsActive("/Admin/Categories") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                    หมวดหมู่
                </a>
                <a asp-page="/Admin/Departments"
                   class="sidebar-link @(IsActive("/Admin/Departments") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 21h18M5 21V7l7-4 7 4v14M9 10h.01M9 14h.01M9 18h.01M15 10h.01M15 14h.01M15 18h.01" />
                    </svg>
                    ฝ่ายที่เกี่ยวข้อง
                </a>
                <a asp-page="/Admin/SlaSettings"
                   class="sidebar-link @(IsActive("/Admin/SlaSettings") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    ตั้งค่า SLA
                </a>
                <a asp-page="/Admin/Notifications"
                   class="sidebar-link @(IsActive("/Admin/Notifications") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    การแจ้งเตือน
                </a>
                <a asp-page="/Admin/ExternalSync"
                   class="sidebar-link @(IsActive("/Admin/ExternalSync") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    ดึงคำร้องจากระบบภายนอก
                </a>

                <!-- ── เนื้อหา ── -->
                <p class="section-subtitle">เนื้อหา</p>
                <a asp-page="/Admin/Terms"
                   class="sidebar-link @(IsActive("/Admin/Terms") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    หลักเกณฑ์ร้องเรียน
                </a>
                <a asp-page="/Admin/HomeContent"
                   class="sidebar-link @(IsActive("/Admin/HomeContent") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                    </svg>
                    เนื้อหาหน้าแรก
                </a>
                <a asp-page="/Admin/PdfSettings"
                   class="sidebar-link @(IsActive("/Admin/PdfSettings") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z" />
                    </svg>
                    ตั้งค่าเอกสาร PDF
                </a>

                <!-- ── Developer ── -->
                <p class="section-subtitle">Developer</p>
                <a asp-page="/Admin/ApiKeys"
                   class="sidebar-link @(IsActive("/Admin/ApiKeys") || IsActive("/Admin/ApiKeyUsage") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    API Keys
                </a>
                <a asp-page="/Admin/Webhooks"
                   class="sidebar-link @(IsActive("/Admin/Webhooks") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Webhooks
                </a>
                <a asp-page="/Admin/AuditLog"
                   class="sidebar-link @(IsActive("/Admin/AuditLog") ? "sidebar-link-active" : "")">
                    <svg class="w-4 h-4 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Audit Log
                </a>
                </div></div>
                </div>
            }
        </nav>

        <!-- Logout -->
        <div class="px-3 py-4 border-t border-slate-200 shrink-0">
            <a asp-page="/Staff/ChangePassword" class="sidebar-link mb-1">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a4 4 0 1 1-2.8 6.85L5 21H3v-2l7.15-7.2A4 4 0 0 1 15 7Z" /></svg>
                เปลี่ยนรหัสผ่าน
            </a>
            <form method="post" asp-page="/Staff/Logout">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="sidebar-link w-full text-slate-500 hover:text-red-700 hover:bg-red-50">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    ออกจากระบบ
                </button>
            </form>
        </div>
    </aside>

    <!-- Sidebar overlay (mobile) -->
    <div id="sidebar-overlay"
         class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-40 lg:hidden"
         aria-hidden="true"
         onclick="setSidebarOpen(false, true)"></div>

    <!-- ═══ MAIN AREA ═══ -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

        <!-- Top header bar -->
        <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-4 sm:px-6 shrink-0 z-10">
            <!-- Mobile sidebar toggle -->
            <button type="button"
                    id="sidebar-toggle"
                    onclick="setSidebarOpen(true)"
                    class="lg:hidden inline-flex h-11 w-11 -ml-1 items-center justify-center rounded-xl hover:bg-gray-100 text-gray-500 transition"
                    aria-controls="sidebar"
                    aria-expanded="false"
                    aria-label="เปิดเมนูระบบ">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-sm ml-2 lg:ml-0">
                <a asp-page="/Index" class="text-gray-400 hover:text-srt-navy transition text-xs">รฟท.</a>
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-gray-800 font-semibold text-sm">@ViewData["Title"]</span>
            </div>

            <!-- Right: date -->
            <div class="flex items-center gap-3 text-sm">
                @if (userRole is "GeneralOfficer" or "SuperAdmin")
                {
                    <form method="get" asp-page="/Staff/Queue" class="hidden md:block">
                        <label for="staff-global-search" class="sr-only">ค้นหาเลขที่เรื่อง ชื่อ หรือเบอร์โทร</label>
                        <input id="staff-global-search" name="Search" type="search" placeholder="ค้นหาเรื่อง…"
                               class="h-10 w-44 rounded-lg border border-slate-300 px-3 text-sm focus:border-srt-navy focus:outline-none focus:ring-2 focus:ring-srt-navy/20 xl:w-64" />
                    </form>
                }
                else if (userRole == "CorruptionOfficer")
                {
                    <form method="get" asp-page="/Corruption/Queue" class="hidden md:block">
                        <label for="corruption-global-search" class="sr-only">ค้นหาเรื่องทุจริต</label>
                        <input id="corruption-global-search" name="Search" type="search" placeholder="ค้นหาเรื่องทุจริต…"
                               class="h-10 w-44 rounded-lg border border-slate-300 px-3 text-sm focus:border-srt-navy focus:outline-none focus:ring-2 focus:ring-srt-navy/20 xl:w-64" />
                    </form>
                }
                <time datetime="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                      class="hidden sm:block text-xs text-gray-400 font-medium">
                    @DateTime.Now.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
                </time>
                @await Html.PartialAsync("_NotificationBell", notificationBell)
                <a asp-page="/Staff/ChangePassword" title="บัญชีและรหัสผ่าน" aria-label="บัญชีและรหัสผ่าน" class="w-10 h-10 rounded-xl bg-srt-navy-50 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-srt-navy">
                    <svg class="h-4 w-4 text-srt-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.1a7.5 7.5 0 0115 0 17.9 17.9 0 01-15 0z" />
                    </svg>
                </a>
            </div>
        </header>

        <!-- Flash messages -->
        @if (TempData["Success"] is string successMsg)
        {
            <div hidden data-swal-toast="success">@successMsg</div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div hidden data-swal-toast="error">@errorMsg</div>
        }
        @if (TempData["Warning"] is string warnMsg)
        {
            <div hidden data-swal-toast="warning">@warnMsg</div>
        }

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto px-4 py-6 sm:px-6 lg:px-8" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/htmx.min.js" defer></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script>
        const staffSidebar = document.getElementById('sidebar');
        const staffSidebarOverlay = document.getElementById('sidebar-overlay');
        const staffSidebarToggle = document.getElementById('sidebar-toggle');
        const staffSidebarClose = document.getElementById('sidebar-close');
        const staffDesktopMedia = window.matchMedia('(min-width: 1024px)');

        function setSidebarOpen(open, restoreFocus = false) {
            if (staffDesktopMedia.matches) return;

            staffSidebar.classList.toggle('-translate-x-full', !open);
            staffSidebar.toggleAttribute('inert', !open);
            staffSidebar.setAttribute('aria-hidden', String(!open));
            staffSidebarOverlay.classList.toggle('hidden', !open);
            staffSidebarToggle.setAttribute('aria-expanded', String(open));

            if (open) {
                staffSidebarClose.focus();
            } else if (restoreFocus) {
                staffSidebarToggle.focus();
            }
        }

        function syncStaffSidebarViewport() {
            staffSidebarOverlay.classList.add('hidden');
            staffSidebarToggle.setAttribute('aria-expanded', 'false');

            if (staffDesktopMedia.matches) {
                staffSidebar.removeAttribute('inert');
                staffSidebar.removeAttribute('aria-hidden');
            } else {
                staffSidebar.classList.add('-translate-x-full');
                staffSidebar.setAttribute('inert', '');
                staffSidebar.setAttribute('aria-hidden', 'true');
            }
        }

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && staffSidebarToggle.getAttribute('aria-expanded') === 'true') {
                event.preventDefault();
                setSidebarOpen(false, true);
            }
        });

        staffDesktopMedia.addEventListener('change', syncStaffSidebarViewport);
        syncStaffSidebarViewport();

        function toggleSidebarSection(id) {
            const body = document.getElementById('section-' + id);
            const btn  = document.querySelector(`.sidebar-section[data-section-id="${id}"] .section-title-btn`);
            const collapsed = body.classList.toggle('collapsed');
            if (btn) btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            localStorage.setItem('sidebar-collapsed-' + id, collapsed ? '1' : '0');
        }

        // Restore collapsed state on load — but always force-expand a section that contains
        // the current page, so navigating never hides where you are.
        document.querySelectorAll('.sidebar-section').forEach(section => {
            const id = section.dataset.sectionId;
            const body = document.getElementById('section-' + id);
            const btn = section.querySelector('.section-title-btn');
            if (!body) return;

            const hasActivePage = body.querySelector('.sidebar-link-active') !== null;
            const storedCollapsed = localStorage.getItem('sidebar-collapsed-' + id) === '1';
            const collapsed = !hasActivePage && storedCollapsed;

            if (collapsed) {
                body.classList.add('collapsed');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
