@page
@model SRT.Complaint.Pages.Admin.TermsModel
@{
    ViewData["Title"] = "หลักเกณฑ์การรับเรื่องร้องเรียน";
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill-table-better@1.2.3/dist/quill-table-better.css" />
}

<!-- Page header -->
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-xl font-bold text-gray-900">หลักเกณฑ์การรับเรื่องร้องเรียน</h1>
        <p class="text-sm text-gray-500 mt-1">จัดการเนื้อหาที่แสดงให้ผู้ใช้ยอมรับก่อนยื่นเรื่อง (ทั้งเรื่องทั่วไปและทุจริต)</p>
    </div>
    @if (Model.CurrentTerms is not null)
    {
        <span class="text-xs text-gray-400">
            อัปเดตล่าสุด: @Model.CurrentTerms.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </span>
    }
</div>

<form method="post" id="terms-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert-error mb-5 [&:empty]:hidden"></div>

    <!-- Status card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-5 p-5">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="font-semibold text-gray-900 text-sm">สถานะการแสดง Modal</h2>
                <p class="text-xs text-gray-500 mt-0.5">เมื่อเปิด ผู้ใช้จะต้องยอมรับหลักเกณฑ์ก่อนยื่นเรื่องทุกครั้ง</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer select-none">
                <input type="checkbox"
                       asp-for="Input.IsActive"
                       id="toggle-active"
                       class="sr-only peer"
                       onchange="updateStatusBadge(this.checked)" />
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2
                            peer-focus:ring-srt-navy/30 rounded-full peer
                            peer-checked:after:translate-x-full peer-checked:after:border-white
                            after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:border-gray-300 after:border after:rounded-full
                            after:h-5 after:w-5 after:transition-all
                            peer-checked:bg-srt-navy"></div>
                <span id="status-badge"
                      class="ml-3 text-sm font-medium @(Model.Input.IsActive ? "text-srt-navy" : "text-gray-400")">
                    @(Model.Input.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")
                </span>
            </label>
        </div>
    </div>

    <!-- Content editor card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-5">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="font-semibold text-gray-900 text-sm">เนื้อหาหลักเกณฑ์</h2>
        </div>
        <div class="p-5 space-y-4">

            <!-- Title -->
            <div>
                <label asp-for="Input.Title" class="form-label">หัวข้อ Modal</label>
                <input asp-for="Input.Title" type="text" class="form-input"
                       placeholder="หลักเกณฑ์การรับเรื่องร้องเรียน" />
                <span asp-validation-for="Input.Title" class="form-error block"></span>
            </div>

            <!-- WYSIWYG editor -->
            <div>
                <label class="form-label mb-2 block">เนื้อหาหลักเกณฑ์</label>
                <p class="text-xs text-gray-500 mb-2">
                    ใช้แถบเครื่องมือด้านบนกล่องข้อความเพื่อจัดรูปแบบ (ตัวหนา, หัวข้อ, สี, ลิสต์, ตาราง, เส้นคั่น ฯลฯ) — ไม่ต้องเขียนโค้ด HTML เอง
                </p>

                <div id="terms-editor" class="terms-editor"></div>
                <textarea asp-for="Input.Content" id="Input_Content" class="hidden" aria-hidden="true"></textarea>
                <span asp-validation-for="Input.Content" class="form-error block"></span>
            </div>
        </div>
    </div>

    <!-- Preview modal card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-5 p-5">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold text-gray-900 text-sm">ตัวอย่าง Modal ที่ผู้ใช้จะเห็น</h2>
            <button type="button"
                    onclick="document.getElementById('modal-demo').classList.toggle('hidden')"
                    class="text-xs text-srt-navy font-medium hover:underline">
                แสดง/ซ่อนตัวอย่าง
            </button>
        </div>
        <div id="modal-demo" class="hidden border border-gray-200 rounded-xl overflow-hidden">
            <div class="bg-srt-navy px-5 py-3 flex items-center gap-3">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <span class="text-white font-bold text-sm" id="demo-title">@Model.Input.Title</span>
            </div>
            <div class="terms-content p-5 max-h-48 overflow-y-auto bg-white" id="demo-content">
                @Html.Raw(Model.Input.Content)
            </div>
            <div class="bg-gray-50 border-t border-gray-200 px-5 py-3 flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 rounded border-2 border-gray-300 bg-white shrink-0"></div>
                    <span class="text-xs text-gray-600">ข้าพเจ้าได้อ่านและยอมรับหลักเกณฑ์ทุกข้อ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Save button -->
    <div class="flex items-center gap-4">
        <button type="submit" class="btn-primary btn-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M5 13l4 4L19 7" />
            </svg>
            บันทึกหลักเกณฑ์
        </button>
        <span class="text-xs text-gray-400">การเปลี่ยนแปลงจะมีผลทันทีสำหรับผู้ใช้ทุกคน</span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill-table-better@1.2.3/dist/quill-table-better.js"></script>
    <script>
        Quill.register({ 'modules/table-better': QuillTableBetter }, true);

        // Custom "แทรกเส้นคั่น" (divider) block — Quill has no built-in <hr> format
        var BlockEmbed = Quill.import('blots/block/embed');
        class DividerBlot extends BlockEmbed {}
        DividerBlot.blotName = 'divider';
        DividerBlot.tagName = 'hr';
        Quill.register(DividerBlot);

        var icons = Quill.import('ui/icons');
        icons['divider'] = '<svg viewBox="0 0 18 18"><line class="ql-stroke" x1="3" y1="9" x2="15" y2="9"></line></svg>';
        icons['undo'] = '<svg viewBox="0 0 18 18"><path class="ql-stroke" d="M3,9 a6,6 0 1 1 1.76,4.24"></path><polyline class="ql-stroke" points="3 4.5 3 9 7.5 9"></polyline></svg>';
        icons['redo'] = '<svg viewBox="0 0 18 18"><path class="ql-stroke" d="M15,9 a6,6 0 1 0 -1.76,4.24"></path><polyline class="ql-stroke" points="15 4.5 15 9 10.5 9"></polyline></svg>';

        var termsQuill = new Quill('#terms-editor', {
            theme: 'snow',
            placeholder: 'พิมพ์เนื้อหาหลักเกณฑ์ที่นี่...',
            modules: {
                table: false,
                'table-better': {
                    language: 'en_US',
                    menus: ['column', 'row', 'merge', 'table', 'cell', 'wrap', 'copy', 'delete'],
                    toolbarTable: true
                },
                keyboard: {
                    bindings: QuillTableBetter.keyboardBindings
                },
                toolbar: {
                    container: [
                        [{ header: [1, 2, 3, 4, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ color: [] }, { background: [] }],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        [{ indent: '-1' }, { indent: '+1' }],
                        [{ align: [] }],
                        ['blockquote', 'link'],
                        ['divider', 'table-better'],
                        ['undo', 'redo'],
                        ['clean']
                    ],
                    handlers: {
                        divider: function () {
                            var range = this.quill.getSelection(true);
                            this.quill.insertEmbed(range.index, 'divider', true, 'user');
                            this.quill.setSelection(range.index + 1, 'silent');
                        },
                        undo: function () { this.quill.history.undo(); },
                        redo: function () { this.quill.history.redo(); }
                    }
                }
            }
        });

        var contentField = document.getElementById('Input_Content');
        termsQuill.clipboard.dangerouslyPasteHTML(contentField.value);
        termsQuill.history.clear();

        function syncContent() {
            var isEmpty = termsQuill.getText().trim().length === 0
                && termsQuill.root.querySelectorAll('table, hr, img').length === 0;
            var html = isEmpty ? '' : termsQuill.root.innerHTML;
            contentField.value = html;
            document.getElementById('demo-content').innerHTML = html;
        }

        termsQuill.on('text-change', syncContent);
        document.getElementById('terms-form').addEventListener('submit', syncContent);

        function updateStatusBadge(checked) {
            var badge = document.getElementById('status-badge');
            badge.textContent = checked ? 'เปิดใช้งาน' : 'ปิดใช้งาน';
            badge.className = 'ml-3 text-sm font-medium ' + (checked ? 'text-srt-navy' : 'text-gray-400');
        }
    </script>
}
