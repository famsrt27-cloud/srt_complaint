@page
@model SRT.Complaint.Pages.Admin.WebhooksModel
@{
    ViewData["Title"] = "Webhooks";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div hidden data-swal-toast="success">@TempData["Success"]</div>
}

<div class="flex items-center justify-between mb-5">
    <div>
        <h1 class="text-xl font-bold text-gray-900">Webhooks</h1>
        <p class="text-gray-500 text-sm mt-0.5">จัดการ Webhook ที่ลงทะเบียนผ่าน API</p>
    </div>
</div>

<details class="mb-6 rounded-xl border border-slate-200 bg-white shadow-sm">
    <summary class="cursor-pointer list-none px-5 py-4 text-sm font-semibold text-srt-navy">+ เพิ่ม Webhook</summary>
    <form method="post" asp-page-handler="Create" class="grid grid-cols-1 gap-4 border-t border-slate-200 p-5 lg:grid-cols-2">
        @Html.AntiForgeryToken()
        <div><label for="webhook-name" class="form-label">ชื่อ <span class="text-red-600">*</span></label><input id="webhook-name" name="NewName" required maxlength="200" class="form-input" placeholder="เช่น ระบบรับเรื่องส่วนกลาง" /></div>
        <div><label for="webhook-key" class="form-label">API Key เจ้าของ <span class="text-red-600">*</span></label><select id="webhook-key" name="NewApiKeyId" required class="form-select"><option value="">-- เลือก API Key --</option>@foreach (var key in Model.ApiKeys) { <option value="@key.Id">@key.Partner.Name — @key.Name (@key.KeyPrefix)</option> }</select></div>
        <div class="lg:col-span-2"><label for="webhook-url" class="form-label">ปลายทาง HTTPS <span class="text-red-600">*</span></label><input id="webhook-url" name="NewTargetUrl" type="url" required maxlength="1000" class="form-input" placeholder="https://partner.example.com/webhooks/srt" /></div>
        <fieldset class="lg:col-span-2"><legend class="form-label">เหตุการณ์ <span class="text-red-600">*</span></legend><div class="flex flex-wrap gap-4">@foreach (var evt in new[] { "complaint.created", "complaint.status_changed", "complaint.closed" }) { <label class="inline-flex min-h-11 items-center gap-2"><input type="checkbox" name="NewEvents" value="@evt" class="rounded border-slate-300 text-srt-navy" /><span class="font-mono text-xs">@evt</span></label> }</div></fieldset>
        <div class="lg:col-span-2 flex justify-end"><button type="submit" class="btn-primary">สร้าง Webhook</button></div>
    </form>
</details>

@if (TempData["WebhookSecret"] is string webhookSecret)
{
    var webhookName = TempData["WebhookName"] as string ?? "Webhook";
    <script>
        document.addEventListener('DOMContentLoaded', () => window.SrtDialog.secret({
            title: 'Webhook signing secret',
            value: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(webhookSecret)),
            target: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(webhookName)),
            expires: 'แสดงเพียงครั้งเดียว กรุณาเก็บใน Secret Manager',
            description: 'ใช้ secret นี้เพื่อตรวจสอบลายเซ็น X-SRT-Signature ที่ปลายทาง',
            copyText: 'คัดลอก signing secret'
        }));
    </script>
}

<!-- Webhooks Table -->
<div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm bg-white mb-6">
    <table class="w-full min-w-[1000px] text-sm border-collapse">
        <thead>
            <tr class="bg-gray-50 text-gray-600 text-left text-xs">
                <th class="px-4 py-3 font-semibold border-b border-gray-200">ชื่อ</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200">API Key</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200">URL ปลายทาง</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200">Events</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200">สถานะล่าสุด</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200">สร้างเมื่อ</th>
                <th class="px-4 py-3 font-semibold border-b border-gray-200 text-right">จัดการ</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Webhooks.Any())
            {
                <tr>
                    <td colspan="7" class="px-4 py-10 text-center text-gray-400 text-sm">ยังไม่มี Webhook ที่ลงทะเบียน</td>
                </tr>
            }
            @foreach (var wh in Model.Webhooks)
            {
                var events = WebhooksModel.ParseEvents(wh.Events);
                <tr class="hover:bg-gray-50/50 border-b border-gray-100 last:border-b-0">
                    <td class="px-4 py-3">
                        <div class="font-medium text-gray-900 text-sm">@wh.Name</div>
                        @if (!wh.IsActive)
                        {
                            <span class="text-xs text-red-500">ปิดใช้งาน</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-600">
                        <div class="font-medium">@(wh.ApiKey?.Name ?? $"#{wh.ApiKeyId}")</div>
                        <div class="text-gray-400">@(wh.ApiKey?.Partner?.Name ?? "-") · @(wh.ApiKey?.Environment ?? "-")</div>
                    </td>
                    <td class="px-4 py-3">
                        <span class="font-mono text-xs text-gray-600 truncate block max-w-[200px]" title="@wh.TargetUrl">
                            @wh.TargetUrl
                        </span>
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex flex-wrap gap-1">
                            @foreach (var ev in events)
                            {
                                <span class="bg-blue-50 text-blue-700 text-xs px-2 py-0.5 rounded font-mono">@ev</span>
                            }
                        </div>
                    </td>
                    <td class="px-4 py-3 text-xs">
                        @if (wh.LastStatusCode.HasValue)
                        {
                            var ok = wh.LastStatusCode >= 200 && wh.LastStatusCode < 300;
                            <span class="@(ok ? "text-green-700" : "text-red-700") font-mono font-medium">@wh.LastStatusCode</span>
                            @if (wh.LastTriggeredAt.HasValue)
                            {
                                <div class="text-gray-400">
                                    @wh.LastTriggeredAt.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-gray-400">ยังไม่ได้ส่ง</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-400">
                        @wh.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                    </td>
                    <td class="px-4 py-3 text-right">
                        <form method="post" asp-page-handler="Delete"
                              data-confirm="ยืนยันลบ Webhook นี้? ระบบจะหยุดส่งเหตุการณ์ไปยังปลายทางทันที"
                              data-confirm-title="ลบ Webhook" data-confirm-text="ลบ" data-confirm-danger="true">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DeleteId" value="@wh.Id" />
                            <button type="submit"
                                    class="text-xs text-red-600 hover:text-red-800 border border-red-200 px-2.5 py-1 rounded-lg hover:bg-red-50 transition">
                                ลบ
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Info box -->
<div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-700">
    <p class="font-semibold mb-1">วิธีสร้าง Webhook</p>
    <p>สร้าง Webhook ผ่าน API: <code class="font-mono bg-blue-100 px-1 rounded">POST /api/v1/webhooks</code> ด้วย scope <code class="font-mono bg-blue-100 px-1 rounded">webhooks:manage</code></p>
    <p class="mt-1">Events ที่รองรับ: <code class="font-mono bg-blue-100 px-1 rounded">complaint.created</code>, <code class="font-mono bg-blue-100 px-1 rounded">complaint.status_changed</code>, <code class="font-mono bg-blue-100 px-1 rounded">complaint.closed</code></p>
</div>
