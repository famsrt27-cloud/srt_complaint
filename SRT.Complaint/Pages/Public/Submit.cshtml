@page
@model SRT.Complaint.Pages.Public.SubmitModel
@using SRT.Complaint.Models
@{
    ViewData["Title"] = "ยื่นเรื่องร้องเรียน";
    Layout = "_Layout";
}

<partial name="_TermsModal" model="Model.Terms" />

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
<div class="max-w-3xl mx-auto">

    <!-- Page Header -->
    <div class="mb-8">
        <nav class="flex items-center gap-2 text-xs text-gray-400 mb-4" aria-label="breadcrumb">
            <a href="/" class="hover:text-srt-navy transition">หน้าแรก</a>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-gray-600 font-medium">ยื่นเรื่องร้องเรียน</span>
        </nav>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">ยื่นเรื่องร้องเรียนทั่วไป</h1>
        <p class="text-gray-500 mt-2">กรุณากรอกข้อมูลให้ครบถ้วน เจ้าหน้าที่จะแจ้งผลทาง SMS/อีเมลภายใน SLA ที่กำหนด</p>
    </div>

<div id="form-content-wrapper" class="@(Model.Terms?.IsActive == true ? "hidden" : "")">
    <form method="post" enctype="multipart/form-data" id="complaint-form" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" id="form-error-summary" role="alert" tabindex="-1"
             class="alert-error mb-6 [&:empty]:hidden focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>

        <!-- Section 1: ข้อมูลผู้ร้องเรียน -->
        <div class="card mb-5">
            <div class="card-header">
                <h2 class="font-bold text-gray-900 flex items-center gap-3 text-sm">
                    <span class="w-7 h-7 bg-srt-navy text-white text-xs font-bold rounded-xl
                                 flex items-center justify-center shrink-0">1</span>
                    ข้อมูลผู้ร้องเรียน
                </h2>
            </div>
            <div class="card-body">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                    <div class="sm:col-span-2">
                        <label asp-for="Input.ReporterName" class="form-label">
                            ชื่อ-นามสกุล <span class="text-red-500" aria-hidden="true">*</span>
                            <span class="sr-only">(จำเป็น)</span>
                        </label>
                        <input asp-for="Input.ReporterName" type="text" autocomplete="name"
                               placeholder="ชื่อ นามสกุล (ไม่ต้องใส่คำนำหน้า)"
                               aria-required="true"
                               aria-describedby="Input_ReporterName-error"
                               class="form-input" />
                        <span id="Input_ReporterName-error" asp-validation-for="Input.ReporterName" class="form-error block" role="alert"></span>
                    </div>

                    <div>
                        <label asp-for="Input.ReporterPhone" class="form-label">
                            เบอร์โทรศัพท์ <span class="text-red-500" aria-hidden="true">*</span>
                            <span class="sr-only">(จำเป็น)</span>
                        </label>
                        <input asp-for="Input.ReporterPhone" type="tel" inputmode="numeric"
                               autocomplete="tel" placeholder="081-234-5678"
                               data-mask="phone" maxlength="12"
                               aria-required="true"
                               aria-describedby="Input_ReporterPhone-error"
                               class="form-input" />
                        <span id="Input_ReporterPhone-error" asp-validation-for="Input.ReporterPhone" class="form-error block" role="alert"></span>
                    </div>

                    <div>
                        <label asp-for="Input.ReporterEmail" class="form-label">
                            อีเมล <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                        </label>
                        <input asp-for="Input.ReporterEmail" type="email" autocomplete="email"
                               placeholder="example@email.com"
                               data-block="thai"
                               class="form-input" />
                        <span asp-validation-for="Input.ReporterEmail" class="form-error block"></span>
                    </div>

                    <div class="sm:col-span-2 sm:max-w-xs">
                        <label asp-for="Input.ReporterIdCard" class="form-label">
                            เลขบัตรประชาชน <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                        </label>
                        <input asp-for="Input.ReporterIdCard" type="text" inputmode="numeric"
                               placeholder="1-2345-67890-12-3"
                               data-mask="id-card" maxlength="17"
                               class="form-input tracking-widest" />
                        <span asp-validation-for="Input.ReporterIdCard" class="form-error block"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Section 2: รายละเอียดเรื่องร้องเรียน -->
        <div class="card mb-5">
            <div class="card-header">
                <h2 class="font-bold text-gray-900 flex items-center gap-3 text-sm">
                    <span class="w-7 h-7 bg-srt-navy text-white text-xs font-bold rounded-xl
                                 flex items-center justify-center shrink-0">2</span>
                    รายละเอียดเรื่องร้องเรียน
                </h2>
            </div>
            <div class="card-body">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                    <div>
                        <label asp-for="Input.CategoryId" class="form-label">
                            ประเภทเรื่อง <span class="text-red-500" aria-hidden="true">*</span>
                            <span class="sr-only">(จำเป็น)</span>
                        </label>
                        <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions"
                                class="form-select" id="category-select"
                                aria-required="true"
                                aria-describedby="Input_CategoryId-error">
                            <option value="">— เลือกประเภทเรื่อง —</option>
                        </select>
                        <span id="Input_CategoryId-error" asp-validation-for="Input.CategoryId" class="form-error block" role="alert"></span>
                    </div>

                    <div id="subcategory-wrap" class="hidden">
                        <label asp-for="Input.SubCategoryId" class="form-label">
                            หัวข้อย่อย <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                        </label>
                        <select asp-for="Input.SubCategoryId" class="form-select" id="subcategory-select">
                            <option value="">— เลือกหัวข้อย่อย —</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Input.SubjectStation" class="form-label">
                            สถานี / จุดที่เกิดเหตุ <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                        </label>
                        <input asp-for="Input.SubjectStation" type="text"
                               placeholder="เช่น สถานีกรุงเทพ, ขบวน 7"
                               class="form-input" />
                        <span asp-validation-for="Input.SubjectStation" class="form-error block"></span>
                    </div>

                    <div class="sm:col-span-2 sm:max-w-xs">
                        <label asp-for="Input.IncidentDate" class="form-label">
                            วันที่เกิดเหตุ <span class="text-gray-400 font-normal">(ถ้าทราบ)</span>
                        </label>
                        <input asp-for="Input.IncidentDate" type="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               data-datepicker
                               class="form-input" />
                        <span asp-validation-for="Input.IncidentDate" class="form-error block"></span>
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="Input.Description" class="form-label">
                            รายละเอียดเรื่องร้องเรียน <span class="text-red-500" aria-hidden="true">*</span>
                            <span class="sr-only">(จำเป็น)</span>
                        </label>
                        <textarea asp-for="Input.Description" rows="6" maxlength="4000"
                                  placeholder="อธิบายรายละเอียดเรื่องที่ต้องการร้องเรียน เช่น เกิดอะไรขึ้น เมื่อใด ใครเกี่ยวข้อง ผลกระทบที่ได้รับ..."
                                  aria-required="true"
                                  aria-describedby="Input_Description-error desc-count-hint"
                                  oninput="document.getElementById('desc-count').textContent = this.value.length"
                                  class="form-textarea w-full"></textarea>
                        <div class="flex justify-between mt-1.5">
                            <span id="Input_Description-error" asp-validation-for="Input.Description" class="form-error block" role="alert"></span>
                            <span id="desc-count-hint" class="text-xs text-gray-400 ml-auto" aria-live="polite">
                                <span id="desc-count">0</span>/4,000 ตัวอักษร
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Section 3: ไฟล์แนบ -->
        <div class="card mb-6">
            <div class="card-header">
                <h2 class="font-bold text-gray-900 flex items-center gap-3 text-sm">
                    <span class="w-7 h-7 bg-srt-navy text-white text-xs font-bold rounded-xl
                                 flex items-center justify-center shrink-0">3</span>
                    ไฟล์แนบ
                    <span class="text-gray-400 font-normal">(ไม่บังคับ)</span>
                </h2>
            </div>
            <div class="card-body">
                <div class="border-2 border-dashed border-gray-200 rounded-2xl p-10 text-center
                            hover:border-srt-navy/40 hover:bg-srt-navy-50/30 transition-all duration-200
                            cursor-pointer group focus:outline-none focus:ring-2 focus:ring-srt-navy focus:ring-offset-2"
                     id="drop-zone" role="button" tabindex="0"
                     aria-label="ลากไฟล์มาวาง หรือกด Enter เพื่อเลือกไฟล์"
                     onclick="document.getElementById('file-input').click()"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('file-input').click();}">
                    <div class="w-12 h-12 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-3
                                group-hover:bg-srt-navy-50 transition-colors duration-200">
                        <svg class="w-6 h-6 text-gray-400 group-hover:text-srt-navy transition-colors duration-200"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-gray-700 mb-1">ลากไฟล์มาวาง หรือคลิกเพื่อเลือก</p>
                    <p class="text-xs text-gray-400">เลือกเพิ่มได้หลายครั้ง · สูงสุด 10 ไฟล์ · 10 MB ต่อไฟล์ · รวมไม่เกิน 50 MB</p>
                    <input type="file" name="Input.Attachments" multiple
                           accept=".jpg,.jpeg,.png,.pdf,.doc,.docx"
                           class="sr-only" id="file-input"
                           onchange="addSelectedFiles(this.files)" />
                </div>

                <ul id="file-list" class="mt-3 space-y-2 hidden" aria-label="รายการไฟล์ที่เลือก"></ul>
                <div id="file-summary" class="hidden mt-3 text-xs text-gray-500" aria-live="polite"></div>
                <div id="file-selection-error" class="form-error mt-2 hidden" role="alert" aria-live="assertive"></div>
                <span asp-validation-for="Input.Attachments" class="form-error block mt-2"></span>
            </div>
        </div>

        <!-- Section 4: การเปิดเผยข้อมูลผู้ร้องเรียน -->
        <fieldset class="card mb-5" aria-describedby="privacy-choice-help Input_ReporterPrivacyChoice-error">
            <legend class="sr-only">การเปิดเผยข้อมูลผู้ร้องเรียน</legend>
            <div class="card-header">
                <h2 class="font-bold text-gray-900 flex items-center gap-3 text-sm">
                    <span class="w-7 h-7 bg-srt-navy text-white text-xs font-bold rounded-xl
                                 flex items-center justify-center shrink-0">4</span>
                    การเปิดเผยข้อมูลผู้ร้องเรียน
                    <span class="text-red-500" aria-hidden="true">*</span>
                    <span class="sr-only">(จำเป็น)</span>
                </h2>
            </div>
            <div class="card-body space-y-3">
                <p id="privacy-choice-help" class="text-sm text-gray-600 leading-relaxed">
                    กรุณาเลือกหนึ่งข้อ ระบบจะสร้างเอกสาร PDF ตามตัวเลือกนี้ และเจ้าหน้าที่ไม่สามารถเปลี่ยนรูปแบบเอกสารเป็นอีกแบบได้
                </p>

                <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer
                              hover:border-srt-navy/50 hover:bg-srt-navy-50 transition-colors">
                    <input asp-for="Input.ReporterPrivacyChoice"
                           type="radio"
                           value="@ReporterPrivacyChoices.Disclose"
                           required
                           class="mt-0.5 h-5 w-5 shrink-0 text-srt-navy focus:ring-srt-navy" />
                    <span>
                        <span class="block text-sm font-semibold text-gray-900">ยินยอมเปิดเผยข้อมูล</span>
                        <span class="block text-xs text-gray-600 leading-relaxed mt-1">
                            ผู้ร้องยินดีเปิดเผยชื่อ-นามสกุล หมายเลขโทรศัพท์ อีเมล และข้อมูลติดต่อใน PDF เพื่อให้เจ้าหน้าที่ติดต่อกลับ
                        </span>
                    </span>
                </label>

                <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer
                              hover:border-srt-navy/50 hover:bg-srt-navy-50 transition-colors">
                    <input asp-for="Input.ReporterPrivacyChoice"
                           type="radio"
                           value="@ReporterPrivacyChoices.Conceal"
                           required
                           class="mt-0.5 h-5 w-5 shrink-0 text-srt-navy focus:ring-srt-navy" />
                    <span>
                        <span class="block text-sm font-semibold text-gray-900">ประสงค์ให้ปกปิดข้อมูล</span>
                        <span class="block text-xs text-gray-600 leading-relaxed mt-1">
                            PDF จะไม่แสดงชื่อ-นามสกุล หมายเลขโทรศัพท์ อีเมล และข้อมูลส่วนบุคคลของผู้ร้องเรียน
                        </span>
                    </span>
                </label>

                <span id="Input_ReporterPrivacyChoice-error"
                      asp-validation-for="Input.ReporterPrivacyChoice"
                      class="form-error block min-h-5"
                      role="alert"></span>
            </div>
        </fieldset>

        <!-- Section 5: วัตถุประสงค์การแจ้งเรื่อง -->
        <fieldset class="card mb-5" aria-describedby="purpose-help Input_SubmissionPurpose-error">
            <legend class="sr-only">วัตถุประสงค์การแจ้งเรื่อง</legend>
            <div class="card-header">
                <h2 class="font-bold text-gray-900 flex items-center gap-3 text-sm">
                    <span class="w-7 h-7 bg-srt-navy text-white text-xs font-bold rounded-xl
                                 flex items-center justify-center shrink-0">5</span>
                    วัตถุประสงค์การแจ้งเรื่อง
                    <span class="text-red-500" aria-hidden="true">*</span>
                    <span class="sr-only">(จำเป็น)</span>
                </h2>
            </div>
            <div class="card-body space-y-3">
                <p id="purpose-help" class="text-sm text-gray-600 leading-relaxed">กรุณาเลือกหนึ่งข้อก่อนยื่นเรื่อง</p>

                <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer
                              hover:border-srt-navy/50 hover:bg-srt-navy-50 transition-colors">
                    <input asp-for="Input.SubmissionPurpose" type="radio"
                           value="@ComplaintSubmissionPurposes.ServiceImprovement" required
                           class="mt-0.5 h-5 w-5 shrink-0 text-srt-navy focus:ring-srt-navy" />
                    <span class="text-sm text-gray-800 leading-relaxed">
                        เรื่องดังกล่าวต้องการแจ้งข้อมูลเพื่อให้การรถไฟแห่งประเทศไทยนำไปใช้เป็นแนวทางในการปรับปรุงและพัฒนาการให้บริการต่อไป
                    </span>
                </label>

                <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer
                              hover:border-srt-navy/50 hover:bg-srt-navy-50 transition-colors">
                    <input asp-for="Input.SubmissionPurpose" type="radio"
                           value="@ComplaintSubmissionPurposes.InvestigationAndContact" required
                           class="mt-0.5 h-5 w-5 shrink-0 text-srt-navy focus:ring-srt-navy" />
                    <span>
                        <span class="block text-sm text-gray-800 leading-relaxed">
                            เรื่องดังกล่าวต้องการให้การรถไฟแห่งประเทศไทยตรวจสอบข้อเท็จจริง พร้อมติดต่อกลับเพื่อชี้แจงผลการดำเนินการ
                        </span>
                        <span class="block text-xs text-gray-500 mt-1">
                            ผู้ร้องยินยอมให้เจ้าหน้าที่ติดต่อกลับทางหมายเลขโทรศัพท์หรืออีเมลที่ระบุด้านบน
                        </span>
                    </span>
                </label>

                <span id="Input_SubmissionPurpose-error" asp-validation-for="Input.SubmissionPurpose"
                      class="form-error block min-h-5" role="alert"></span>
            </div>
        </fieldset>

        <!-- Privacy Notice -->
        <div class="bg-srt-navy-50 border border-srt-navy-100 rounded-2xl p-4 mb-6 flex gap-3">
            <svg class="w-4 h-4 text-srt-navy shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <p class="text-xs text-srt-navy/80 leading-relaxed">
                <strong class="text-srt-navy">ข้อมูลส่วนบุคคล:</strong> ข้อมูลที่ท่านให้ไว้จะถูกใช้เพื่อดำเนินการตามเรื่องร้องเรียนเท่านั้น
                และปกป้องตามนโยบายความเป็นส่วนตัวของ รฟท. สอบถามเพิ่มเติม ☎ 1690
            </p>
        </div>

        <!-- Turnstile -->
        @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
        {
            <div class="cf-turnstile mb-4"
                 data-sitekey="@Model.TurnstileSiteKey"
                 data-theme="light"
                 data-language="th">
            </div>
        }

        <!-- Actions -->
        <div class="flex items-center gap-4">
            <button type="submit" id="submit-btn" class="btn-primary btn-lg">
                <span id="submit-spinner"
                      class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"
                      aria-hidden="true"></span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                ยื่นเรื่องร้องเรียน
            </button>
            <a asp-page="/Index" class="text-sm text-gray-400 hover:text-gray-600 transition font-medium">ยกเลิก</a>
        </div>

    </form>
</div>
</div>
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
    <script>
        $.validator.setDefaults({
            normalizer: function (value) {
                if ($(this).data('mask')) return value.replace(/\D/g, '');
                return value;
            }
        });
        /* ─── Input masks ─────────────────────────────────────────── */
        function applyPhoneMask(el) {
            const raw = el.value.replace(/\D/g, '');
            const d = raw.slice(0, 10);
            if (d.length <= 2) { el.value = d; return; }
            // Bangkok landline starts with 02 → 0X-XXX-XXXX (9 digits max)
            if (d[1] === '2') {
                const s = d.slice(0, 9);
                if (s.length <= 5) el.value = s.slice(0, 2) + '-' + s.slice(2);
                else el.value = s.slice(0, 2) + '-' + s.slice(2, 5) + '-' + s.slice(5);
            } else {
                // Mobile / regional: 0XX-XXX-XXXX (10 digits)
                if (d.length <= 3) el.value = d;
                else if (d.length <= 6) el.value = d.slice(0, 3) + '-' + d.slice(3);
                else el.value = d.slice(0, 3) + '-' + d.slice(3, 6) + '-' + d.slice(6);
            }
        }

        function applyIdCardMask(el) {
            const d = el.value.replace(/\D/g, '').slice(0, 13);
            let f = d.slice(0, 1);
            if (d.length > 1)  f += '-' + d.slice(1, 5);
            if (d.length > 5)  f += '-' + d.slice(5, 10);
            if (d.length > 10) f += '-' + d.slice(10, 12);
            if (d.length > 12) f += '-' + d.slice(12, 13);
            el.value = f;
        }

        function initMasks(form) {
            form.querySelectorAll('[data-mask="phone"]').forEach(function (el) {
                el.addEventListener('input', function () { applyPhoneMask(this); });
                if (el.value) applyPhoneMask(el);
            });
            form.querySelectorAll('[data-mask="id-card"]').forEach(function (el) {
                el.addEventListener('input', function () { applyIdCardMask(this); });
                if (el.value) applyIdCardMask(el);
            });
            // Strip dashes before jQuery Validate fires (capture phase → before bubble)
            form.addEventListener('submit', function () {
                form.querySelectorAll('[data-mask="phone"]').forEach(function (el) {
                    el.value = el.value.replace(/\D/g, '');
                });
                form.querySelectorAll('[data-mask="id-card"]').forEach(function (el) {
                    el.value = el.value.replace(/\D/g, '');
                });
            }, true);
        }

        (function () {
            const form = document.getElementById('complaint-form');
            initMasks(form);
            const summary = document.getElementById('form-error-summary');
            if (summary && summary.querySelector('li')) summary.focus();
        })();
        /* ────────────────────────────────────────────────────────── */

        (function () {
            const ta = document.querySelector('textarea[name="Input.Description"]');
            if (ta) document.getElementById('desc-count').textContent = ta.value.length;
        })();

        (function () {
            const subCats = @Html.Raw(Model.SubCategoriesJson);
            const catSel = document.getElementById('category-select');
            const subWrap = document.getElementById('subcategory-wrap');
            const subSel = document.getElementById('subcategory-select');
            const selectedSubId = '@(Model.Input.SubCategoryId)';

            function updateSubCats() {
                const catId = catSel.value;
                const items = subCats[catId] || [];
                subSel.innerHTML = '<option value="">— เลือกหัวข้อย่อย —</option>';
                if (items.length === 0) {
                    subWrap.classList.add('hidden');
                    return;
                }
                items.forEach(function (s) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.name;
                    if (String(s.id) === selectedSubId) opt.selected = true;
                    subSel.appendChild(opt);
                });
                subWrap.classList.remove('hidden');
            }

            catSel.addEventListener('change', updateSubCats);
            if (catSel.value) updateSubCats();
        })();

        const selectedFiles = [];
        let previewUrls = [];
        const MAX_FILE_COUNT = 10;
        const MAX_FILE_SIZE = 10 * 1024 * 1024;
        const MAX_TOTAL_SIZE = 50 * 1024 * 1024;

        function fileKey(file) {
            return `${file.name}|${file.size}|${file.lastModified}`;
        }

        function syncFileInput() {
            const transfer = new DataTransfer();
            selectedFiles.forEach(file => transfer.items.add(file));
            fileInput.files = transfer.files;
        }

        function showFileError(message) {
            const error = document.getElementById('file-selection-error');
            error.textContent = message;
            error.classList.toggle('hidden', !message);
        }

        function addSelectedFiles(files) {
            showFileError('');
            const existing = new Set(selectedFiles.map(fileKey));
            for (const file of Array.from(files || [])) {
                if (existing.has(fileKey(file))) continue;
                if (file.size > MAX_FILE_SIZE) {
                    showFileError(`ไฟล์ “${file.name}” มีขนาดเกิน 10 MB`);
                    continue;
                }
                if (selectedFiles.length >= MAX_FILE_COUNT) {
                    showFileError('แนบไฟล์ได้ไม่เกิน 10 ไฟล์');
                    break;
                }
                const totalAfterAdd = selectedFiles.reduce((sum, item) => sum + item.size, 0) + file.size;
                if (totalAfterAdd > MAX_TOTAL_SIZE) {
                    showFileError('ขนาดไฟล์แนบรวมต้องไม่เกิน 50 MB');
                    continue;
                }
                selectedFiles.push(file);
                existing.add(fileKey(file));
            }
            syncFileInput();
            updateFileList();
        }

        function removeSelectedFile(index) {
            selectedFiles.splice(index, 1);
            showFileError('');
            syncFileInput();
            updateFileList();
        }

        function updateFileList() {
            const list = document.getElementById('file-list');
            const summary = document.getElementById('file-summary');
            previewUrls.forEach(url => URL.revokeObjectURL(url));
            previewUrls = [];
            list.innerHTML = '';
            if (selectedFiles.length === 0) {
                list.classList.add('hidden');
                summary.classList.add('hidden');
                return;
            }
            list.classList.remove('hidden');
            summary.classList.remove('hidden');
            const totalSize = selectedFiles.reduce((sum, file) => sum + file.size, 0);
            summary.textContent = `เลือกแล้ว ${selectedFiles.length} ไฟล์ · ${(totalSize / 1024 / 1024).toFixed(1)} MB จาก 50 MB`;

            selectedFiles.forEach((file, index) => {
                const li = document.createElement('li');
                li.className = 'flex flex-wrap sm:flex-nowrap items-center gap-2 text-xs text-gray-700 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3';

                const name = document.createElement('span');
                name.className = 'min-w-0 flex-1 truncate font-medium';
                name.textContent = file.name;
                li.appendChild(name);

                const size = document.createElement('span');
                size.className = 'shrink-0 text-gray-400';
                size.textContent = `${(file.size / 1024 / 1024).toFixed(1)} MB`;
                li.appendChild(size);

                const preview = document.createElement('a');
                const previewUrl = URL.createObjectURL(file);
                previewUrls.push(previewUrl);
                preview.href = previewUrl;
                preview.target = '_blank';
                preview.rel = 'noopener noreferrer';
                preview.className = 'shrink-0 font-semibold text-srt-navy hover:underline focus:outline-none focus:ring-2 focus:ring-srt-navy rounded';
                preview.textContent = 'เปิดดู';
                preview.setAttribute('aria-label', `เปิดดูไฟล์ ${file.name}`);
                li.appendChild(preview);

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'shrink-0 min-w-11 min-h-11 sm:min-w-0 sm:min-h-0 px-2 text-red-600 font-semibold hover:underline focus:outline-none focus:ring-2 focus:ring-red-500 rounded';
                remove.textContent = 'ลบ';
                remove.setAttribute('aria-label', `ลบไฟล์ ${file.name}`);
                remove.addEventListener('click', () => removeSelectedFile(index));
                li.appendChild(remove);

                list.appendChild(li);
            });
        }

        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');
        dropZone.addEventListener('dragover', e => {
            e.preventDefault();
            dropZone.classList.add('border-srt-navy', 'bg-srt-navy-50');
        });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-srt-navy', 'bg-srt-navy-50'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('border-srt-navy', 'bg-srt-navy-50');
            addSelectedFiles(e.dataTransfer.files);
        });

        document.getElementById('complaint-form').addEventListener('submit', function () {
            if (!this.checkValidity() || !$(this).valid()) return;
            const btn = document.getElementById('submit-btn');
            const spinner = document.getElementById('submit-spinner');
            btn.disabled = true;
            spinner.classList.remove('hidden');
            btn.querySelector('svg:not(.animate-spin)')?.classList.add('hidden');
        });
    </script>
}
