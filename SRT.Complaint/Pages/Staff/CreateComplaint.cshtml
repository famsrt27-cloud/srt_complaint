@page
@model SRT.Complaint.Pages.Staff.CreateComplaintModel
@{
    ViewData["Title"] = "สร้างเรื่องร้องเรียนใหม่";
    Layout = "_StaffLayout";
}

<div class="w-full">
    <div class="page-header">
        <div class="flex items-start gap-3">
            <a asp-page="/Staff/Queue" class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 hover:text-slate-800" aria-label="กลับไปคิวเรื่องร้องเรียน">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7" /></svg>
            </a>
            <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-blue-700">New complaint</p><h1 class="page-title">สร้างเรื่องร้องเรียนใหม่</h1><p class="page-subtitle">บันทึกเรื่องที่ได้รับจากโทรศัพท์ อีเมล โซเชียลมีเดีย หรือการติดต่อโดยตรง</p></div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="space-y-5">
        @Html.AntiForgeryToken()

        <div id="validation-summary" asp-validation-summary="All"
             class="validation-summary-panel" role="alert" tabindex="-1"></div>

        <aside class="card p-4 sm:p-5" aria-label="ขั้นตอนการกรอกข้อมูล">
            <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">ข้อมูลที่ต้องกรอก</p>
                <p class="text-xs leading-5 text-slate-500"><span class="font-semibold text-slate-700">หมายเหตุ:</span> ช่องที่มีเครื่องหมาย <span class="text-red-600">*</span> จำเป็นต้องกรอก</p>
            </div>
            <ol class="grid grid-cols-1 gap-2 md:grid-cols-3">
                <li><a href="#channel-section" class="flex gap-3 rounded-lg bg-blue-50 p-3 text-blue-700"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span><span><span class="block text-sm font-semibold">ช่องทางรับเรื่อง</span><span class="mt-0.5 block text-xs text-blue-600">เลือกแหล่งที่ได้รับเรื่อง</span></span></a></li>
                <li><a href="#reporter-section" class="flex gap-3 rounded-lg p-3 text-slate-600 hover:bg-slate-50"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-slate-300 bg-white text-xs font-bold">2</span><span><span class="block text-sm font-semibold">ข้อมูลผู้ร้อง</span><span class="mt-0.5 block text-xs text-slate-400">ชื่อและข้อมูลติดต่อ</span></span></a></li>
                <li><a href="#detail-section" class="flex gap-3 rounded-lg p-3 text-slate-600 hover:bg-slate-50"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-slate-300 bg-white text-xs font-bold">3</span><span><span class="block text-sm font-semibold">รายละเอียดเรื่อง</span><span class="mt-0.5 block text-xs text-slate-400">ประเภท สถานที่ และเหตุการณ์</span></span></a></li>
            </ol>
        </aside>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <section id="channel-section" class="border-b border-slate-200 p-5 sm:p-6" aria-labelledby="channel-heading">
                <div class="mb-5"><div class="flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span><h2 id="channel-heading" class="text-base font-semibold text-slate-900">ช่องทางที่รับเรื่อง</h2></div><p class="ml-9 mt-1 text-sm text-slate-500">เลือกช่องทางต้นทางเพื่อให้รายงานแยกข้อมูลได้ถูกต้อง</p></div>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6" id="channel-grid">
                    @foreach (var ch in CreateComplaintModel.ChannelOptions)
                    {
                        var icon = ch.Value switch
                        {
                            "Phone" => "M3 5a2 2 0 012-2h3l2 6-3 2a12 12 0 006 6l2-3 6 2v3a2 2 0 01-2 2h-1C10 21 3 14 3 6V5z",
                            "Facebook" => "M17 2h-3a5 5 0 00-5 5v3H6v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3",
                            "Line" => "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4-4 8-9 8-2 0-3-.3-4-.9L3 20l1-4c-1-1-1-2-1-4 0-4 4-8 9-8s9 4 9 8z",
                            "Email" => "M3 8l8 5a2 2 0 002 0l8-5M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
                            "Walkin" => "M16 7a4 4 0 11-8 0 4 4 0 018 0zM5 21a7 7 0 0114 0",
                            _ => "M9 9a3 3 0 116 0c0 2-3 2-3 4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        };
                        <label class="channel-card cursor-pointer">
                            <input type="radio" name="Input.Channel" value="@ch.Value" class="sr-only" required @((Model.Input.Channel == ch.Value || (string.IsNullOrWhiteSpace(Model.Input.Channel) && ch.Value == "Phone")) ? "checked" : "") />
                            <span class="channel-option flex min-h-24 flex-col items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white p-3 text-center transition-colors hover:border-blue-300 hover:bg-blue-50/40"><svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="@icon" /></svg><span class="text-xs font-medium text-slate-700">@ch.Text</span></span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Input.Channel" class="form-error block"></span>
            </section>

            <section id="reporter-section" class="border-b border-slate-200 p-5 sm:p-6" aria-labelledby="reporter-heading">
                <div class="mb-5"><div class="flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600">2</span><h2 id="reporter-heading" class="text-base font-semibold text-slate-900">ข้อมูลผู้ร้องเรียน</h2></div><p class="ml-9 mt-1 text-sm text-slate-500">ใช้สำหรับติดต่อกลับและแจ้งความคืบหน้า</p></div>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div><label asp-for="Input.ReporterName" class="form-label">ชื่อ-นามสกุล <span class="text-red-600">*</span></label><input asp-for="Input.ReporterName" class="form-input" placeholder="ชื่อ นามสกุล" autocomplete="name" required /><span asp-validation-for="Input.ReporterName" class="form-error block" role="alert"></span></div>
                    <div><label for="reporter-phone" class="form-label">เบอร์โทรศัพท์ <span class="text-red-600">*</span></label><input asp-for="Input.ReporterPhone" type="tel" class="form-input" placeholder="081-234-5678" inputmode="tel" autocomplete="tel" id="reporter-phone" required /><span asp-validation-for="Input.ReporterPhone" class="form-error block" role="alert"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Input.ReporterEmail" class="form-label">อีเมล <span class="font-normal text-slate-400">(ถ้ามี)</span></label><input asp-for="Input.ReporterEmail" type="email" class="form-input" placeholder="example@email.com" autocomplete="email" spellcheck="false" /><span asp-validation-for="Input.ReporterEmail" class="form-error block" role="alert"></span></div>
                </div>
            </section>

            <section id="detail-section" class="p-5 sm:p-6" aria-labelledby="detail-heading">
                <div class="mb-5"><div class="flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600">3</span><h2 id="detail-heading" class="text-base font-semibold text-slate-900">รายละเอียดเรื่องร้องเรียน</h2></div><p class="ml-9 mt-1 text-sm text-slate-500">ระบุข้อมูลให้ครบเพื่อช่วยให้เจ้าหน้าที่ส่งต่อได้รวดเร็ว</p></div>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div><label for="category-select" class="form-label">ประเภทเรื่อง <span class="text-red-600">*</span></label><select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" id="category-select" class="form-select" onchange="updateSubCategories(this.value)" required><option value="">-- เลือกประเภท --</option></select><span asp-validation-for="Input.CategoryId" class="form-error block" role="alert"></span></div>
                    <div><label for="sub-category-select" class="form-label">หัวข้อย่อย <span id="subcategory-requirement" class="font-normal text-slate-400">(เลือกเมื่อมีรายการ)</span></label><select asp-for="Input.SubCategoryId" id="sub-category-select" class="form-select" disabled><option value="">-- เลือกหัวข้อย่อย --</option></select><span asp-validation-for="Input.SubCategoryId" class="form-error block" role="alert"></span></div>
                    <div><label asp-for="Input.SubjectStation" class="form-label">สถานที่ / สถานี <span class="text-red-600">*</span></label><input asp-for="Input.SubjectStation" class="form-input" placeholder="เช่น สถานีกรุงเทพ" autocomplete="off" required /><span asp-validation-for="Input.SubjectStation" class="form-error block" role="alert"></span></div>
                    <div><label for="incident-date" class="form-label">วันที่เกิดเหตุ <span class="text-red-600">*</span></label><input asp-for="Input.IncidentDate" type="date" class="form-input" id="incident-date" autocomplete="off" required /><span asp-validation-for="Input.IncidentDate" class="form-error block" role="alert"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Input.Description" class="form-label">รายละเอียดคำร้อง <span class="text-red-600">*</span></label><textarea asp-for="Input.Description" class="form-textarea" rows="7" minlength="20" maxlength="4000" required placeholder="อธิบายเหตุการณ์ สถานที่ บุคคลที่เกี่ยวข้อง และสิ่งที่ต้องการให้ดำเนินการ…"></textarea><div class="mt-1 flex justify-between gap-4"><span asp-validation-for="Input.Description" class="form-error block" role="alert"></span><span class="text-xs text-slate-400">อย่างน้อย 20 ตัวอักษร และควรระบุข้อมูลที่ช่วยให้ตรวจสอบได้</span></div></div>
                    <div class="sm:col-span-2">
                        <label for="staff-attachments" class="form-label">ไฟล์หลักฐาน <span class="font-normal text-slate-400">(ถ้ามี)</span></label>
                        <input id="staff-attachments" asp-for="Attachments" type="file" multiple accept=".jpg,.jpeg,.png,.pdf,.doc,.docx"
                               class="file-input" />
                        <p class="mt-1 text-xs text-slate-500">สูงสุด 10 ไฟล์ ไฟล์ละไม่เกิน 10 MB: JPG, PNG, PDF, DOC, DOCX</p>
                        <span asp-validation-for="Attachments" class="form-error block"></span>
                    </div>
                </div>
            </section>

            <div class="flex flex-col-reverse gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-6"><a asp-page="/Staff/Queue" class="btn-secondary">ยกเลิก</a><button type="submit" class="btn-primary"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>สร้างเรื่องร้องเรียน</button></div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const subData = @Html.Raw(Model.SubCategoriesJson);
    function updateSubCategories(catId) {
        const select = document.getElementById('sub-category-select');
        const requirement = document.getElementById('subcategory-requirement');
        const selectedValue = select.dataset.selected || '';
        select.innerHTML = '<option value="">-- เลือกหัวข้อย่อย --</option>';
        const items = subData[catId] || [];
        items.forEach(item => select.add(new Option(item.Name, item.Id, false, String(item.Id) === selectedValue)));
        select.disabled = items.length === 0;
        select.required = items.length > 0;
        requirement.textContent = items.length > 0 ? '*' : '(ไม่มีหัวข้อย่อย)';
        requirement.classList.toggle('text-red-600', items.length > 0);
        requirement.classList.toggle('text-slate-400', items.length === 0);
        requirement.classList.toggle('font-normal', items.length === 0);
    }

    document.getElementById('reporter-phone')?.addEventListener('input', function () {
        let value = this.value.replace(/\D/g, '').slice(0, 10);
        if (value.length > 6) value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6);
        else if (value.length > 3) value = value.slice(0, 3) + '-' + value.slice(3);
        this.value = value;
    });

    const complaintForm = document.querySelector('form[method="post"]');
    complaintForm?.addEventListener('submit', function () {
        const phone = document.getElementById('reporter-phone');
        if (phone) phone.value = phone.value.replace(/-/g, '');
    });

    function syncChannelCards() {
        document.querySelectorAll('input[name="Input.Channel"]').forEach(input => {
            const option = input.closest('label').querySelector('.channel-option');
            const icon = option.querySelector('svg');
            option.classList.toggle('border-blue-600', input.checked);
            option.classList.toggle('bg-blue-50', input.checked);
            option.classList.toggle('ring-1', input.checked);
            option.classList.toggle('ring-blue-600', input.checked);
            option.classList.toggle('border-slate-200', !input.checked);
            icon.classList.toggle('text-blue-700', input.checked);
            icon.classList.toggle('text-slate-500', !input.checked);
        });
    }
    document.querySelectorAll('input[name="Input.Channel"]').forEach(input => input.addEventListener('change', syncChannelCards));
    syncChannelCards();

    const subSelect = document.getElementById('sub-category-select');
    subSelect.dataset.selected = '@(Model.Input.SubCategoryId?.ToString() ?? "")';
    const categorySelect = document.getElementById('category-select');
    if (categorySelect.value) updateSubCategories(categorySelect.value);

    const validationSummary = document.getElementById('validation-summary');
    if (validationSummary?.classList.contains('validation-summary-errors')) {
        validationSummary.focus();
    }
</script>
}
