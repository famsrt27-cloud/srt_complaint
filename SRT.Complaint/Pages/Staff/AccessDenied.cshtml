@page
@model SRT.Complaint.Pages.Staff.AccessDeniedModel
@{
    ViewData["Title"] = "ไม่มีสิทธิ์เข้าถึง";
    Layout = "_Layout";
}

<main class="mx-auto flex min-h-[65vh] max-w-2xl items-center px-4 py-12">
    <section class="w-full rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:p-10" aria-labelledby="access-denied-title">
        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-amber-50 text-amber-700" aria-hidden="true">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M5.1 19h13.8a2 2 0 0 0 1.73-3L13.73 4a2 2 0 0 0-3.46 0L3.37 16a2 2 0 0 0 1.73 3Z" /></svg>
        </div>
        <h1 id="access-denied-title" class="text-2xl font-bold text-slate-900">บัญชีนี้ไม่มีสิทธิ์เข้าถึงหน้านี้</h1>
        <p class="mt-3 text-slate-600">ระบบแยกสิทธิ์งานเรื่องร้องเรียนทั่วไป งานทุจริต และงานผู้ดูแลระบบเพื่อคุ้มครองข้อมูล</p>
        <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="@Model.HomeUrl" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-srt-navy px-5 py-2.5 font-semibold text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-srt-navy focus:ring-offset-2">กลับหน้าหลักของฉัน</a>
            <a asp-page="/Index" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 px-5 py-2.5 font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-srt-navy">เว็บไซต์ประชาชน</a>
        </div>
    </section>
</main>
