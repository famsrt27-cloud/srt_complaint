@page
@model SRT.Complaint.Pages.Staff.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "เข้าสู่ระบบเจ้าหน้าที่";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] — การรถไฟแห่งประเทศไทย</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-dvh bg-slate-50 font-thai text-slate-900 antialiased">
    <main class="grid min-h-dvh lg:grid-cols-2">
        <section class="flex items-center justify-center px-4 py-10 sm:px-8 lg:px-12" aria-labelledby="login-title">
            <div class="w-full max-w-md">
                <a asp-page="/Index" class="mb-8 inline-flex items-center gap-3" aria-label="กลับหน้าหลัก">
                    <img src="~/images/srt-logo.png" alt="การรถไฟแห่งประเทศไทย" class="h-12 w-auto object-contain" />
                    <span class="border-l border-slate-200 pl-3"><span class="block text-sm font-bold text-slate-900">ระบบจัดการเรื่องร้องเรียน</span><span class="block text-xs text-slate-500">การรถไฟแห่งประเทศไทย</span></span>
                </a>

                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                    <div class="mb-7"><p class="mb-2 text-xs font-semibold uppercase tracking-wider text-blue-700">Staff portal</p><h1 id="login-title" class="text-2xl font-bold tracking-tight text-slate-900">เข้าสู่ระบบเจ้าหน้าที่</h1><p class="mt-2 text-sm text-slate-500">กรอกรหัสพนักงานและรหัสผ่านเพื่อดำเนินการต่อ</p></div>

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert-error mb-5" role="alert"><svg class="mt-0.5 h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16ZM8.7 7.3a1 1 0 00-1.4 1.4L8.6 10l-1.3 1.3a1 1 0 101.4 1.4l1.3-1.3 1.3 1.3a1 1 0 001.4-1.4L11.4 10l1.3-1.3a1 1 0 00-1.4-1.4L10 8.6 8.7 7.3Z" clip-rule="evenodd" /></svg><span>@Model.ErrorMessage</span></div>
                    }

                    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="space-y-5">
                        @Html.AntiForgeryToken()
                        <div>
                            <label asp-for="Input.EmployeeCode" class="form-label">รหัสพนักงาน</label>
                            <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 3h10a2 2 0 012 2v16H5V5a2 2 0 012-2Zm2 5h6m-6 4h6m-6 4h3" /></svg></span><input asp-for="Input.EmployeeCode" autocomplete="username" inputmode="numeric" maxlength="7" placeholder="เลขรหัสพนักงาน 7 หลัก" data-block="digits-only" class="form-input pl-10 font-mono tracking-widest" /></div>
                            <span asp-validation-for="Input.EmployeeCode" class="form-error block"></span>
                        </div>
                        <div>
                            <label asp-for="Input.Password" class="form-label">รหัสผ่าน</label>
                            <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2Zm10-10V7a4 4 0 00-8 0v4" /></svg></span><input asp-for="Input.Password" id="password-field" autocomplete="current-password" placeholder="••••••••" data-block="thai" class="form-input pl-10 pr-11" /><button type="button" id="password-toggle-btn" onclick="togglePassword()" aria-pressed="false" aria-label="แสดงรหัสผ่าน" class="absolute inset-y-0 right-0 flex items-center rounded-r-lg px-3 text-slate-400 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500"><svg id="eye-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12C3.7 8 7.5 5 12 5s8.3 3 9.5 7c-1.2 4-5 7-9.5 7s-8.3-3-9.5-7Z" /></svg></button></div>
                            <span asp-validation-for="Input.Password" class="form-error block"></span>
                        </div>
                        <div class="flex items-center"><input asp-for="Input.RememberMe" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-500" /><label asp-for="Input.RememberMe" class="ml-2 text-sm text-slate-600">จดจำการเข้าสู่ระบบ 7 วัน</label></div>

                        @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
                        {
                            <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="light" data-language="th" data-appearance="always"></div>
                        }

                        <button type="submit" class="btn-primary w-full py-3"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m10 17 5-5-5-5m5 5H3m12-8h4a2 2 0 012 2v12a2 2 0 01-2 2h-4" /></svg>เข้าสู่ระบบ</button>
                    </form>
                </div>
                <p class="mt-6 text-center text-xs leading-5 text-slate-400">สงวนสิทธิ์สำหรับเจ้าหน้าที่การรถไฟแห่งประเทศไทย<br />หากไม่สามารถเข้าสู่ระบบได้ กรุณาติดต่อ IT Support</p>
            </div>
        </section>

        <aside class="relative hidden overflow-hidden border-l border-blue-100 bg-blue-50 lg:flex lg:items-center lg:justify-center" aria-label="ข้อมูลระบบ">
            <div class="absolute inset-0 opacity-50" style="background-image:radial-gradient(#93c5fd 1px,transparent 1px);background-size:28px 28px" aria-hidden="true"></div>
            <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-blue-200/40 blur-2xl" aria-hidden="true"></div>
            <div class="relative w-full max-w-xl px-12">
                <div class="mb-10"><span class="mb-5 inline-flex rounded-lg border border-blue-200 bg-white px-3 py-1.5 text-xs font-semibold text-blue-700 shadow-sm">SRT Complaint Management</span><h2 class="text-3xl font-bold leading-tight text-slate-900">ดูแลทุกเรื่องร้องเรียน<br />อย่างเป็นระบบและตรวจสอบได้</h2><p class="mt-4 max-w-lg text-sm leading-6 text-slate-600">พื้นที่ทำงานสำหรับเจ้าหน้าที่ ตั้งแต่รับเรื่อง มอบหมาย ติดตาม SLA ไปจนถึงแจ้งผลแก่ผู้ร้องเรียน</p></div>
                <div class="rounded-xl border border-white/80 bg-white/90 p-6 shadow-sm backdrop-blur">
                    <svg class="mb-6 h-28 w-full" viewBox="0 0 480 120" fill="none" aria-hidden="true"><path d="M12 88h456" stroke="#CBD5E1" stroke-width="2"/><path d="M42 88C100 88 92 34 156 34s64 54 128 54 60-54 148-54" stroke="#2563EB" stroke-width="4" stroke-linecap="round"/><circle cx="42" cy="88" r="8" fill="#fff" stroke="#2563EB" stroke-width="4"/><circle cx="156" cy="34" r="8" fill="#fff" stroke="#2563EB" stroke-width="4"/><circle cx="284" cy="88" r="8" fill="#fff" stroke="#2563EB" stroke-width="4"/><circle cx="432" cy="34" r="8" fill="#fff" stroke="#2563EB" stroke-width="4"/></svg>
                    <div class="grid grid-cols-3 divide-x divide-slate-200 text-center"><div><p class="text-lg font-bold text-slate-900">รับเรื่อง</p><p class="mt-1 text-xs text-slate-500">ทุกช่องทาง</p></div><div><p class="text-lg font-bold text-slate-900">ติดตาม</p><p class="mt-1 text-xs text-slate-500">ตาม SLA</p></div><div><p class="text-lg font-bold text-slate-900">แจ้งผล</p><p class="mt-1 text-xs text-slate-500">ตรวจสอบได้</p></div></div>
                </div>
            </div>
        </aside>
    </main>

    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script>
        function togglePassword() {
            const field = document.getElementById('password-field');
            const icon = document.getElementById('eye-icon');
            const button = document.getElementById('password-toggle-btn');
            const show = field.type === 'password';
            field.type = show ? 'text' : 'password';
            button.setAttribute('aria-pressed', String(show));
            button.setAttribute('aria-label', show ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');
            icon.innerHTML = show
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 3l18 18M10.6 10.6a2 2 0 002.8 2.8M9.9 5.2A9 9 0 0112 5c4.5 0 8.3 3 9.5 7a10 10 0 01-2 3.5M6.2 6.2A10 10 0 002.5 12c1.2 4 5 7 9.5 7 1.2 0 2.4-.2 3.4-.6" />'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12C3.7 8 7.5 5 12 5s8.3 3 9.5 7c-1.2 4-5 7-9.5 7s-8.3-3-9.5-7Z" />';
        }
    </script>
</body>
</html>
