@page
@model SRT.Complaint.Pages.Staff.DashboardModel
@{
    ViewData["Title"] = "แดชบอร์ด";
    var stats = Model.Stats;
    var weeklyTotal = stats.ChartData.Sum();
    var todayChange = stats.YesterdayCount == 0
        ? (stats.TodayCount > 0 ? 100 : 0)
        : (int)Math.Round((double)(stats.TodayCount - stats.YesterdayCount) / stats.YesterdayCount * 100);
    var changeColor = todayChange >= 0 ? "text-emerald-600" : "text-red-600";
    var changeArrow = todayChange >= 0 ? "↑" : "↓";
    var maxTotal = stats.CategoryBreakdown.Any() ? stats.CategoryBreakdown.Max(x => x.Total) : 1;
}

<div class="mx-auto max-w-[1600px]">
    <div class="page-header">
        <div>
            <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-blue-700">Operations overview</p>
            <h1 id="dashboard-title" class="page-title">แดชบอร์ดเรื่องร้องเรียน</h1>
            <p class="page-subtitle">ติดตามงานใหม่ ภาระงาน และ SLA จากหน้าจอเดียว</p>
        </div>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
            <a asp-page="/Staff/CreateComplaint" class="btn-primary"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>สร้างเรื่องใหม่</a>
            <a asp-page="/Staff/Queue" class="btn-secondary">ดูคิวทั้งหมด</a>
        </div>
    </div>

    <section class="mb-5 grid grid-cols-1 gap-5 xl:grid-cols-12" aria-labelledby="weekly-heading">
        <div class="card p-5 sm:p-6 xl:col-span-8">
            <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <div class="flex items-center gap-2"><h2 id="weekly-heading" class="text-base font-semibold text-slate-900">ปริมาณเรื่องร้องเรียน</h2><span class="rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">7 วันล่าสุด</span></div>
                    <div class="mt-3 flex items-end gap-3"><span class="text-3xl font-bold tracking-tight text-slate-900">@weeklyTotal</span><span class="pb-1 text-sm text-slate-500">เรื่องทั้งหมดในช่วงนี้</span></div>
                </div>
                <p class="text-xs text-slate-400">อัปเดตอัตโนมัติทุก 60 วินาที</p>
            </div>
            <div class="h-72"><canvas id="weeklyChart" role="img" aria-label="กราฟเส้นแสดงจำนวนเรื่องร้องเรียนรายวันย้อนหลัง 7 วัน"></canvas></div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 xl:col-span-4 xl:grid-cols-1">
            <a asp-page="/Staff/Queue" asp-route-status="Pending" class="card flex items-center justify-between p-5 transition-colors hover:border-blue-300">
                <div><p class="text-sm font-medium text-slate-500">เรื่องใหม่วันนี้</p><p class="mt-2 text-3xl font-bold text-slate-900">@stats.TodayCount</p><p class="mt-1 text-xs text-slate-500"><span class="font-semibold @changeColor">@changeArrow @Math.Abs(todayChange)%</span> จากเมื่อวาน</p></div>
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-50 text-blue-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6L19 9.4V19a2 2 0 01-2 2Z" /></svg></span>
            </a>
            <a asp-page="/Staff/Queue" class="card flex items-center justify-between p-5 transition-colors hover:border-blue-300">
                <div><p class="text-sm font-medium text-slate-500">กำลังดำเนินการ</p><p class="mt-2 text-3xl font-bold text-slate-900">@stats.InProgressCount</p><p class="mt-1 text-xs text-slate-500">รับแล้ว @stats.AssignedCount · รอรับ @stats.UnassignedCount</p></div>
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M5.6 15A8 8 0 0019 9M5 9a8 8 0 0013.4 6" /></svg></span>
            </a>
            <a asp-page="/Staff/Queue" class="card flex items-center justify-between p-5 transition-colors hover:border-amber-300">
                <div><p class="text-sm font-medium text-slate-500">ใกล้ครบ SLA</p><p class="mt-2 text-3xl font-bold text-amber-600">@stats.SlaWarningCount</p><p class="mt-1 text-xs text-slate-500">ตามเกณฑ์ของแต่ละระดับความสำคัญ</p></div>
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-amber-50 text-amber-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0Z" /></svg></span>
            </a>
            <a asp-page="/Staff/Queue" class="card flex items-center justify-between p-5 transition-colors @(stats.SlaBreachedCount > 0 ? "border-red-200 bg-red-50/30 hover:border-red-300" : "hover:border-emerald-300")">
                <div><p class="text-sm font-medium text-slate-500">เกิน SLA</p><p class="mt-2 text-3xl font-bold @(stats.SlaBreachedCount > 0 ? "text-red-600" : "text-emerald-600")">@stats.SlaBreachedCount</p><p class="mt-1 text-xs @(stats.SlaBreachedCount > 0 ? "font-medium text-red-600" : "text-slate-500")">@(stats.SlaBreachedCount > 0 ? "ต้องดำเนินการด่วน" : "สถานะปกติ")</p></div>
                <span class="flex h-11 w-11 items-center justify-center rounded-lg @(stats.SlaBreachedCount > 0 ? "bg-red-100 text-red-700" : "bg-emerald-50 text-emerald-700")"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 4h.01M10.3 4.5 2.8 18a2 2 0 001.8 3h14.8a2 2 0 001.8-3L13.7 4.5a2 2 0 00-3.4 0Z" /></svg></span>
            </a>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-5 xl:grid-cols-12">
        <div class="card xl:col-span-5">
            <div class="card-header"><div><h2 class="text-base font-semibold text-slate-900">ประเภทเรื่องที่พบบ่อย</h2><p class="mt-0.5 text-xs text-slate-500">เปรียบเทียบจำนวนรวมและงานที่กำลังดำเนินการ</p></div></div>
            <div class="card-body">
                @if (stats.CategoryBreakdown.Any())
                {
                    <div class="space-y-4">
                        @foreach (var item in stats.CategoryBreakdown)
                        {
                            var pct = maxTotal > 0 ? (double)item.Total / maxTotal * 100 : 0;
                            var pctActive = item.Total > 0 ? (double)item.Active / item.Total * 100 : 0;
                            <div><div class="mb-1.5 flex justify-between gap-4 text-sm"><span class="truncate text-slate-600">@item.CategoryName</span><span class="font-semibold text-slate-900">@item.Total</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-100"><div class="relative h-2 rounded-full bg-blue-100" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"><div class="absolute inset-y-0 left-0 rounded-full bg-blue-700" style="width:@pctActive.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div></div>
                        }
                    </div>
                    <p class="mt-4 text-xs text-slate-400">สีน้ำเงินเข้ม = กำลังดำเนินการ</p>
                }
                else { <p class="py-10 text-center text-sm text-slate-400">ยังไม่มีข้อมูล</p> }
            </div>
        </div>

        <div class="card xl:col-span-7">
            <div class="card-header"><div><h2 class="text-base font-semibold text-slate-900">เรื่องที่ต้องติดตาม SLA</h2><p class="mt-0.5 text-xs text-slate-500">เรียงลำดับงานเร่งด่วนที่ควรจัดการก่อน</p></div><a asp-page="/Staff/Queue" class="text-sm font-medium text-blue-700 hover:text-blue-800">ดูทั้งหมด</a></div>
            @if (!stats.SlaWarningItems.Any())
            {
                <div class="empty-state py-12"><span class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 13 4 4L19 7" /></svg></span><p class="font-medium text-slate-700">SLA ปกติทุกเรื่อง</p><p class="mt-1 text-sm text-slate-400">ยังไม่มีงานที่ใกล้หรือเกินกำหนด</p></div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var item in stats.SlaWarningItems)
                    {
                        <a asp-page="/Staff/CaseDetail" asp-route-id="@item.Id" class="flex items-center gap-4 px-5 py-4 transition-colors hover:bg-slate-50 sm:px-6"><span class="h-2.5 w-2.5 shrink-0 rounded-full @(item.SlaBreached ? "bg-red-500" : "bg-amber-400")"></span><div class="min-w-0 flex-1"><p class="truncate text-sm font-semibold text-slate-900">@item.ReferenceNumber · @item.CategoryName</p><p class="mt-0.5 truncate text-xs text-slate-500">ผู้ร้อง: @item.ReporterName</p></div><span class="shrink-0 text-xs font-semibold @(item.SlaBreached ? "text-red-600" : "text-amber-600")">@item.SlaRemainingText</span><svg class="h-4 w-4 shrink-0 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></a>
                    }
                </div>
            }
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
    (function () {
        const canvas = document.getElementById('weeklyChart');
        if (!canvas) return;
        new Chart(canvas, {
            type: 'line',
            data: { labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.ChartLabels)), datasets: [{ label: 'จำนวนเรื่อง', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.ChartData)), borderColor: '#1d4ed8', backgroundColor: 'rgba(37, 99, 235, .10)', pointBackgroundColor: '#fff', pointBorderColor: '#1d4ed8', pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 5, borderWidth: 3, fill: true, tension: .38 }] },
            options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} เรื่อง` } } }, scales: { y: { beginAtZero: true, ticks: { precision: 0, color: '#64748b' }, grid: { color: 'rgba(148,163,184,.18)' }, border: { display: false } }, x: { ticks: { color: '#64748b' }, grid: { display: false }, border: { display: false } } } }
        });
        setTimeout(() => location.reload(), 60000);
    })();
    </script>
}
