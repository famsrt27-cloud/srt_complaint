@page "{id:int}"
@model SRT.Complaint.Pages.Staff.CaseDetailModel
@using System.Security.Claims
@{
    ViewData["Title"] = $"เรื่อง {Model.Complaint.ReferenceNumber}";
    var c = Model.Complaint;
    var currentStaffId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var isAssignedToMe = c.AssignedToId == currentStaffId;
    var canModify = User.IsInRole("SuperAdmin") || isAssignedToMe;
    var isClosed = c.Status is "Closed" or "Rejected";
    var maskReporterInPdf = ReporterPrivacyChoices.ShouldMask(c.ReporterPrivacyChoice);
    var hasPrivacyChoice = ReporterPrivacyChoices.IsValid(c.ReporterPrivacyChoice);
    var now = DateTime.UtcNow;
    var slaBreached = c.SlaBreached || (c.SlaDeadline.HasValue && c.SlaDeadline < now);
    var workflowNumber = ComplaintWorkflowSteps.Number(c.WorkflowStep);
    var displayedWorkflowNumber = Math.Min(workflowNumber, 6);
    var latestInfoRequest = c.Notes.Where(n => n.NoteType == "InfoRequest").OrderByDescending(n => n.CreatedAt).FirstOrDefault();
    var hasReporterReply = latestInfoRequest != null && c.Notes.Any(n => n.NoteType == "ReporterReply" && n.CreatedAt > latestInfoRequest.CreatedAt);

    string StepInstruction(int step) => step switch
    {
        1 => "รับเรื่องและยืนยันว่าคุณเป็นผู้รับผิดชอบ ก่อนเริ่มตรวจข้อมูล",
        2 => "ตรวจข้อมูลผู้ร้อง รายละเอียดเหตุการณ์ ช่องทางติดต่อ และเอกสารว่าครบถ้วน",
        3 => "ตรวจและบันทึกประเภทเรื่อง ฝ่ายรับผิดชอบ ผู้รับผิดชอบ และกำหนด SLA",
        4 => "บันทึกสิ่งที่ตรวจสอบ การดำเนินการ ผลที่พบ และหลักฐานประกอบ",
        5 => "เรียบเรียงผลดำเนินการเป็นข้อความที่ชัดเจนและปลอดภัยสำหรับแจ้งผู้ร้อง",
        6 => "ตรวจข้อความครั้งสุดท้าย แล้วแจ้งผลและปิดเรื่อง",
        _ => "ตรวจสอบความครบถ้วนของงาน"
    };

    string StatusColor(string s) => s switch
    {
        "Pending" => "bg-amber-100 text-amber-800 border-amber-200",
        "InProgress" => "bg-blue-100 text-blue-800 border-blue-200",
        "WaitingInfo" => "bg-amber-100 text-amber-800 border-amber-200",
        "Forwarded" => "bg-purple-100 text-purple-800 border-purple-200",
        "UnderReview" => "bg-indigo-100 text-indigo-800 border-indigo-200",
        "Resolved" => "bg-blue-100 text-blue-800 border-blue-200",
        "Closed" => "bg-gray-200 text-gray-700 border-gray-300",
        "Rejected" => "bg-red-100 text-red-800 border-red-200",
        _ => "bg-gray-100 text-gray-700 border-gray-200"
    };
    string PriorityColor(string p) => p switch
    {
        "Critical" => "bg-red-100 text-red-800 border-red-200",
        "Urgent" => "bg-orange-100 text-orange-800 border-orange-200",
        "High" => "bg-yellow-100 text-yellow-800 border-yellow-200",
        _ => "bg-gray-100 text-gray-700 border-gray-200"
    };
    string EdocStatusLabel(string s) => s switch
    {
        "Pending" => "รอส่ง",
        "Sending" => "กำลังส่ง",
        "Sent" => "สร้างเอกสารแล้ว",
        "SentWithAttachmentErrors" => "สร้างแล้ว (ไฟล์แนบไม่ครบ)",
        "NeedsReview" => "ต้องตรวจสอบ",
        "Failed" => "ส่งไม่สำเร็จ",
        _ => s
    };
    string EdocStatusColor(string s) => s switch
    {
        "Sent" => "bg-green-100 text-green-800 border-green-200",
        "Sending" or "Pending" => "bg-blue-100 text-blue-800 border-blue-200",
        "SentWithAttachmentErrors" or "NeedsReview" => "bg-amber-100 text-amber-800 border-amber-200",
        "Failed" => "bg-red-100 text-red-800 border-red-200",
        _ => "bg-gray-100 text-gray-700 border-gray-200"
    };
}

<!-- ══ Page Header ══ -->
<div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
        <a asp-page="/Staff/Queue"
           aria-label="กลับไปหน้าคิวเรื่องร้องเรียน"
           class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-srt-navy transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <h1 class="text-base font-semibold text-gray-900 font-mono">@c.ReferenceNumber</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium border @StatusColor(c.Status)">
            @CaseDetailModel.StatusLabel(c.Status)
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium border @PriorityColor(c.Priority)">
            @CaseDetailModel.PriorityLabel(c.Priority)
        </span>
        @if (slaBreached)
        {
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-600 text-white">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 3.6L2.4 17.3A2 2 0 004.1 20h15.8a2 2 0 001.7-2.7L13.7 3.6a2 2 0 00-3.4 0z" />
                </svg>
                เกิน SLA
            </span>
        }
    </div>
    <div class="flex items-center gap-3">
        <span class="text-xs text-gray-400">
            รับเมื่อ @c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </span>
        <button type="button" id="pdf-modal-open" onclick="openPdfModal()" class="inline-flex min-h-11 items-center gap-1.5 text-xs text-srt-navy border border-srt-navy/30
            px-3 py-1.5 rounded-lg hover:bg-srt-navy hover:text-white transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            PDF
        </button>
        <form method="post" asp-page-handler="DownloadExcel" asp-route-id="@c.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-green-600/40 px-3 py-1.5 text-xs font-medium text-green-700 transition hover:bg-green-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2">
                Excel
            </button>
        </form>
        <form method="post" asp-page-handler="DownloadWord" asp-route-id="@c.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-blue-600/40 px-3 py-1.5 text-xs font-medium text-blue-700 transition hover:bg-blue-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-700 focus:ring-offset-2">
                Word
            </button>
        </form>

        <!-- Modal ดาวน์โหลด PDF ตามตัวเลือกที่ผู้ร้องบันทึกไว้ -->
        <div id="pdf-modal"
             class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm overscroll-contain"
             role="dialog" aria-modal="true" aria-labelledby="pdf-modal-title" tabindex="-1">
            <div class="max-h-[90vh] overflow-y-auto bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 p-6">
                <h3 id="pdf-modal-title" class="text-base font-semibold text-gray-900 mb-1">ดาวน์โหลด PDF</h3>
                <p class="text-sm text-gray-500 mb-4">
                    ระบบกำหนดรูปแบบเอกสารจากตัวเลือกที่ผู้ร้องบันทึกไว้
                </p>

                @if (!hasPrivacyChoice)
                {
                    <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800 leading-relaxed">
                        รายการนี้ไม่มีข้อมูลการเลือกจากผู้ร้อง ระบบจึงใช้แบบปกปิดข้อมูลโดยอัตโนมัติ
                    </div>
                }

                <form method="post" asp-page-handler="DownloadPdf" asp-route-id="@c.Id">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label for="pdf-department" class="block text-sm font-medium text-gray-800 mb-1.5">
                            ฝ่ายงานที่เกี่ยวข้อง <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                        <select id="pdf-department" name="PdfDepartmentName" required
                                onchange="togglePdfDepartmentOther(this)"
                                class="form-select-compact w-full min-h-11">
                            <option value="">— เลือกฝ่ายงาน —</option>
                            @foreach (var department in Model.PdfDepartmentOptions)
                            {
                                <option value="@department" selected="@(department == (c.ResponsibleDepartment ?? c.Category.DepartmentName))">@department</option>
                            }
                            <option value="__other">ฝ่ายงานอื่น (ระบุชื่อ)</option>
                        </select>
                        <p class="mt-1.5 text-xs text-gray-500">
                            ชื่อฝ่ายงานจะแสดงในบรรทัด “เรียน” บนเอกสาร PDF
                        </p>
                    </div>

                    <div id="pdf-department-other-wrapper" class="hidden mb-4">
                        <label for="pdf-department-other" class="block text-sm font-medium text-gray-800 mb-1.5">
                            ระบุชื่อฝ่ายงาน <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                        <input id="pdf-department-other" name="PdfDepartmentOther" type="text" maxlength="200"
                               autocomplete="off" placeholder="เช่น ฝ่ายเทคโนโลยีสารสนเทศ"
                               class="form-input-compact w-full min-h-11" />
                    </div>

                    <button type="submit" class="w-full flex items-start gap-3 p-4 rounded-xl border-2 border-gray-200
                        hover:border-blue-400 hover:bg-blue-50 active:bg-blue-100
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition text-left group">
                        <div class="mt-0.5 w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center shrink-0
                                    group-hover:bg-blue-100 transition">
                            @if (maskReporterInPdf)
                            {
                                <svg class="w-4 h-4 text-gray-500 group-hover:text-blue-600 transition" fill="none"
                                     stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-gray-500 group-hover:text-blue-600 transition" fill="none"
                                     stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            }
                        </div>
                        <span>
                            <span class="block text-sm font-semibold text-gray-800">
                                @(maskReporterInPdf ? "ดาวน์โหลดแบบปกปิดข้อมูล" : "ดาวน์โหลดแบบแสดงข้อมูลครบถ้วน")
                            </span>
                            <span class="block text-xs text-gray-500 mt-0.5">
                                @(maskReporterInPdf
                                    ? "ไม่แสดงชื่อ เบอร์โทร อีเมล และข้อมูลส่วนบุคคลของผู้ร้อง"
                                    : "แสดงชื่อ เบอร์โทร และอีเมลตามที่ผู้ร้องยินยอม")
                            </span>
                        </span>
                    </button>
                </form>

                <button type="button" id="pdf-modal-close" onclick="closePdfModal()"
                        class="mt-4 w-full min-h-11 text-sm text-gray-500 hover:text-gray-700 transition">
                            ยกเลิก
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <script>
            let pdfModalPreviousFocus = null;
            function openPdfModal() {
                const modal = document.getElementById('pdf-modal');
                pdfModalPreviousFocus = document.activeElement;
                modal.classList.remove('hidden');
                document.getElementById('pdf-department')?.focus();
            }
            function closePdfModal() {
                document.getElementById('pdf-modal').classList.add('hidden');
                pdfModalPreviousFocus?.focus();
            }
            document.addEventListener('keydown', function (event) {
                const modal = document.getElementById('pdf-modal');
                if (!modal || modal.classList.contains('hidden')) return;
                if (event.key === 'Escape') {
                    event.preventDefault();
                    closePdfModal();
                    return;
                }
                if (event.key !== 'Tab') return;
                const focusable = Array.from(modal.querySelectorAll('button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href]'));
                if (!focusable.length) return;
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            });

            function togglePdfDepartmentOther(select) {
                const wrapper = document.getElementById('pdf-department-other-wrapper');
                const input = document.getElementById('pdf-department-other');
                const isOther = select.value === '__other';
                wrapper.classList.toggle('hidden', !isOther);
                input.required = isOther;
                if (!isOther) input.value = '';
            }
        </script>

        <!-- ══ Guided workflow timeline ══ -->
        <section class="mb-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm"
                 aria-labelledby="workflow-title">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="workflow-title" class="text-base font-bold text-gray-900">ขั้นตอนการดำเนินเรื่อง</h2>
                    <p class="mt-1 text-sm text-gray-600">
                        @(workflowNumber > 6 ? "ดำเนินการครบทุกขั้นตอนแล้ว" : $"ขั้นตอนที่ {workflowNumber} จาก 6 — {ComplaintWorkflowSteps.ThaiLabel(c.WorkflowStep)}")
                    </p>
                </div>
                <span class="inline-flex w-fit rounded-full border border-srt-navy/20 bg-srt-navy-50 px-3 py-1 text-xs font-semibold text-srt-navy">
                    @ComplaintWorkflowSteps.ThaiLabel(c.WorkflowStep)
                </span>
            </div>

            <nav class="mt-6" aria-label="ความคืบหน้าการดำเนินเรื่อง">
                <ol class="grid grid-cols-6 gap-1 sm:gap-3">
                    @for (var progressStep = 1; progressStep <= 6; progressStep++)
                    {
                        var progressCompleted = workflowNumber > progressStep;
                        var progressCurrent = workflowNumber == progressStep;
                        <li class="relative flex min-w-0 flex-col items-center text-center">
                            @if (progressStep < 6)
                            {
                                <span class="absolute left-1/2 top-4 h-0.5 w-full @(progressCompleted ? "bg-emerald-500" : "bg-slate-200")" aria-hidden="true"></span>
                            }
                            <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 text-xs font-bold transition-colors
                                         @(progressCompleted ? "border-emerald-600 bg-emerald-600 text-white" : progressCurrent ? "border-srt-navy bg-white text-srt-navy ring-4 ring-srt-navy/10" : "border-slate-300 bg-white text-slate-500")"
                                  aria-hidden="true">
                                @if (progressCompleted)
                                {
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                    </svg>
                                }
                                else
                                {
                                    @progressStep
                                }
                            </span>
                            <span class="mt-2 hidden max-w-28 text-xs leading-5 lg:block @(progressCurrent ? "font-semibold text-srt-navy" : progressCompleted ? "text-emerald-700" : "text-slate-500")">
                                @ComplaintWorkflowSteps.Title(progressStep)
                            </span>
                            <span class="sr-only">
                                ขั้นตอนที่ @progressStep: @ComplaintWorkflowSteps.Title(progressStep)
                                @(progressCompleted ? "เสร็จแล้ว" : progressCurrent ? "กำลังดำเนินการ" : "ยังไม่เริ่ม")
                            </span>
                        </li>
                    }
                </ol>
            </nav>

            @if (workflowNumber > 6)
            {
                <div class="mt-6 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">
                    <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                        <p class="font-semibold">ดำเนินการครบทุกขั้นตอนแล้ว</p>
                        <p class="mt-1 text-sm text-emerald-800">หากจำเป็นต้องดำเนินการต่อ ให้ใช้คำสั่ง “เปิดเรื่องใหม่” ระบบจะกลับไปขั้นตอนที่ 2</p>
                    </div>
                </div>
            }

            <ol class="mt-6">
                @for (var step = 1; step <= 6; step++)
                {
                    var completed = workflowNumber > step;
                    var current = workflowNumber == step;
                    var locked = workflowNumber < step;
                    <li class="@(current ? "" : "hidden") overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/70">
                        <div class="flex items-start gap-3 p-4 sm:p-6">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold
                                         @(completed ? "bg-green-700 text-white" : current ? "bg-srt-navy text-white" : "bg-gray-200 text-gray-600")"
                                  aria-hidden="true">
                                @if (completed)
                                {
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                    </svg>
                                }
                                else if (locked)
                                {
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11V7a4 4 0 00-8 0v4m-1 0h10a1 1 0 011 1v7a1 1 0 01-1 1H3a1 1 0 01-1-1v-7a1 1 0 011-1z" transform="translate(4 0)" />
                                    </svg>
                                }
                                else
                                {
                                    @step
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <h3 class="text-sm font-semibold text-gray-900">@step. @ComplaintWorkflowSteps.Title(step)</h3>
                                    <span class="text-xs font-medium @(completed ? "text-green-700" : current ? "text-srt-navy" : "text-gray-500")">
                                        @(completed ? "เสร็จแล้ว" : current ? "กำลังดำเนินการ" : $"ต้องผ่านขั้น {step - 1} ก่อน")
                                    </span>
                                </div>

                                @if (current && (canModify || (step == 1 && !c.AssignedToId.HasValue)))
                                {
                                    <div class="mt-4 border-t border-gray-200 pt-4">
                                        <div class="mb-4 rounded-xl border border-blue-100 bg-white p-4">
                                            <p class="text-xs font-bold uppercase tracking-wider text-srt-navy">สิ่งที่ต้องทำในขั้นนี้</p>
                                            <p class="mt-1 text-sm leading-6 text-gray-700">@StepInstruction(step)</p>
                                        </div>
                                        @if (step == 1)
                                        {
                                            <p class="text-sm text-gray-600">กดรับเรื่องเพื่อยืนยันผู้รับผิดชอบและเริ่มตรวจสอบข้อมูล</p>
                                            @if (!c.AssignedToId.HasValue)
                                            {
                                                <form method="post" asp-page-handler="Claim" asp-route-id="@c.Id" class="mt-3">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-primary min-h-11">รับเรื่องและไปขั้นถัดไป</button>
                                                </form>
                                            }
                                        }
                                        else if (step == 2)
                                        {
                                            @if (c.WorkflowStep == ComplaintWorkflowSteps.WaitingInfo)
                                            {
                                                @if (hasReporterReply)
                                                {
                                                    <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                                                        <p class="font-semibold">ผู้ร้องส่งข้อมูลเพิ่มเติมแล้ว</p>
                                                        <p class="mt-1 text-emerald-800">ตรวจข้อความและไฟล์ในส่วน “ประวัติและบันทึก” แล้วดำเนินการตรวจสอบต่อ</p>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="text-sm text-amber-800">ส่งคำขอให้ผู้ร้องแล้ว ขณะนี้กำลังรอข้อความหรือเอกสารเพิ่มเติม</p>
                                                }
                                                <form method="post" asp-page-handler="ResumeScreening" asp-route-id="@c.Id" class="mt-3">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-primary min-h-11">
                                                        @(hasReporterReply ? "ตรวจข้อมูลแล้ว ดำเนินการต่อ" : "ได้รับข้อมูลจากช่องทางอื่น ดำเนินการต่อ")
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <p class="text-sm text-gray-600">ตรวจชื่อผู้ร้อง ช่องทางติดต่อ รายละเอียด และเอกสารประกอบให้ครบถ้วน</p>
                                                <div class="mt-3 flex flex-col gap-3 sm:flex-row">
                                                    <form method="post" asp-page-handler="CompleteScreening" asp-route-id="@c.Id">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn-primary min-h-11">ข้อมูลครบถ้วน ไปขั้นถัดไป</button>
                                                    </form>
                                                    <form method="post" asp-page-handler="RequestMoreInfo" asp-route-id="@c.Id" class="flex-1">
                                                        @Html.AntiForgeryToken()
                                                        <label for="workflow-reason" class="form-label">ข้อมูลที่ต้องการเพิ่มเติม</label>
                                                        <textarea id="workflow-reason" name="WorkflowReason" required rows="2" class="form-textarea-compact w-full" placeholder="ระบุข้อมูลหรือเอกสารที่ต้องการเพิ่ม"></textarea>
                                                        <button type="submit" class="mt-2 min-h-11 rounded-lg border border-amber-400 px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50">ขอข้อมูลเพิ่มเติม</button>
                                                    </form>
                                                </div>
                                            }
                                        }
                                        else if (step == 3)
                                        {
                                            <form method="post" asp-page-handler="SaveAndCompleteClassification" asp-route-id="@c.Id" class="space-y-3">
                                                @Html.AntiForgeryToken()
                                                <div>
                                                    <label for="classification-category" class="form-label">ประเภทเรื่อง</label>
                                                    <select id="classification-category" name="ClassificationCategoryId" required class="form-select-compact min-h-11 w-full">
                                                        @foreach (var category in Model.ClassificationCategoryOptions)
                                                        {
                                                            <option value="@category.Value" selected="@(category.Value == Model.ClassificationCategoryId.ToString())">@category.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div id="classification-subcategory-wrapper">
                                                    <label for="classification-subcategory" class="form-label">หัวข้อย่อย</label>
                                                    <select id="classification-subcategory" name="ClassificationSubCategoryId" class="form-select-compact min-h-11 w-full"></select>
                                                </div>
                                                <div>
                                                    <label for="classification-department" class="form-label">ฝ่ายรับผิดชอบ</label>
                                                    <select id="classification-department" name="ClassificationDepartment" class="form-select-compact min-h-11 w-full">
                                                        <option value="">— ใช้ฝ่ายตามประเภทเรื่อง —</option>
                                                        @foreach (var department in Model.ClassificationDepartmentOptions)
                                                        {
                                                            <option value="@department" selected="@(department == Model.ClassificationDepartment)">@department</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs text-gray-600">
                                                    ผู้รับผิดชอบ: <strong>@(c.AssignedTo?.FullName ?? "ยังไม่ได้กำหนด")</strong>
                                                    <span class="mx-1">•</span>
                                                    SLA: <strong>@(c.SlaDeadline?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "ยังไม่ได้กำหนด")</strong>
                                                </div>
                                                <button type="submit" class="btn-primary min-h-11">บันทึกและเริ่มดำเนินการ</button>
                                            </form>
                                        }
                                        else if (step == 4)
                                        {
                                            <form method="post" asp-page-handler="CompleteInvestigation" asp-route-id="@c.Id" enctype="multipart/form-data" class="space-y-3">
                                                @Html.AntiForgeryToken()
                                                <div>
                                                    <label for="investigation-note" class="form-label">สิ่งที่ดำเนินการ <span class="text-red-600" aria-hidden="true">*</span></label>
                                                    <textarea id="investigation-note" name="InvestigationNote" required maxlength="4000" rows="3" class="form-textarea-compact w-full" placeholder="เช่น ติดต่อหน่วยงาน ตรวจสอบพื้นที่ หรือประสานผู้เกี่ยวข้อง…"></textarea>
                                                </div>
                                                <div>
                                                    <label for="investigation-files" class="form-label">หลักฐานประกอบ <span class="font-normal text-gray-500">(ถ้ามี)</span></label>
                                                    <input id="investigation-files" type="file" name="InvestigationAttachments" multiple accept=".jpg,.jpeg,.png,.pdf,.doc,.docx"
                                                           class="file-input" />
                                                </div>
                                                <div>
                                                    <label for="investigation-summary" class="form-label">สรุปผลการตรวจสอบและดำเนินการ</label>
                                                    <textarea id="investigation-summary" name="InvestigationSummary" required minlength="20" maxlength="4000" rows="4" class="form-textarea-compact w-full" placeholder="สรุปสิ่งที่ตรวจสอบ การดำเนินการ และผลที่พบ"></textarea>
                                                </div>
                                                <div>
                                                    <label for="no-evidence-reason" class="form-label">เหตุผลที่ไม่มีหลักฐาน <span class="font-normal text-gray-500">(กรอกเมื่อไม่มีไฟล์แนบ)</span></label>
                                                    <textarea id="no-evidence-reason" name="NoEvidenceReason" maxlength="1000" rows="2" class="form-textarea-compact w-full"></textarea>
                                                </div>
                                                <p class="text-xs text-gray-500">หากไม่มีหลักฐานแนบ ต้องระบุเหตุผลให้ชัดเจน</p>
                                                <button type="submit" class="btn-primary min-h-11">ยืนยันผลการตรวจสอบและไปสรุปผล</button>
                                            </form>
                                        }
                                        else if (step == 5)
                                        {
                                            <form method="post" asp-page-handler="PrepareClosure" asp-route-id="@c.Id" class="space-y-3">
                                                @Html.AntiForgeryToken()
                                                <div>
                                                    <label for="workflow-close-opening" class="form-label">ประโยคขึ้นต้น</label>
                                                    <select id="workflow-close-opening" name="CloseOpening" required class="form-select-compact w-full">
                                                        <option value="">— เลือกประโยคขึ้นต้น —</option>
                                                        @foreach (var option in CaseDetailModel.CloseOpeningOptions)
                                                        {
                                                            <option value="@option.Key">@option.Value</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div>
                                                    <label for="workflow-close-resolution" class="form-label">รายละเอียดสรุปผล</label>
                                                    <textarea id="workflow-close-resolution" name="CloseResolution" required minlength="20" maxlength="4000" rows="4" class="form-textarea-compact w-full"></textarea>
                                                </div>
                                                <label class="flex items-start gap-3 rounded-lg border border-gray-200 bg-white p-3">
                                                    <input type="checkbox" name="ClosureChecklistConfirmed" value="true" required class="mt-0.5 h-5 w-5 text-srt-navy focus:ring-srt-navy" />
                                                    <span class="text-sm text-gray-700">ตรวจข้อเท็จจริง ผลดำเนินการ หลักฐาน และข้อความสำหรับผู้ร้องแล้ว ไม่มีข้อมูลภายในหรือข้อมูลอ่อนไหวที่ไม่ควรเปิดเผย</span>
                                                </label>
                                                <button type="submit" class="btn-primary min-h-11">ยืนยันสรุปผลและไปขั้นแจ้งผล</button>
                                            </form>
                                        }
                                        else if (step == 6)
                                        {
                                            <div class="rounded-lg border border-blue-200 bg-white p-3">
                                                <p class="text-xs font-semibold text-srt-navy">ข้อความที่จะส่งให้ผู้ร้อง</p>
                                                <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-gray-800">@c.ResolutionSummary</p>
                                            </div>
                                            <form method="post" asp-page-handler="ClosePrepared" asp-route-id="@c.Id" class="mt-3">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="min-h-11 rounded-lg bg-green-700 px-4 py-2 text-sm font-semibold text-white hover:bg-green-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-600 focus-visible:ring-offset-2">
                                                    แจ้งผลและปิดเรื่อง
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>

            @if (canModify && !isClosed && displayedWorkflowNumber > 2)
            {
                <div class="mt-4 flex flex-col gap-2 border-t border-slate-200 pt-4 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-xs leading-5 text-slate-500">ต้องแก้ข้อมูลจากขั้นก่อนหน้า? ข้อมูลที่บันทึกไว้จะไม่ถูกลบ</p>
                    <form method="post" asp-page-handler="PreviousWorkflowStep" asp-route-id="@c.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                data-confirm="ย้อนกลับไปขั้นตอนก่อนหน้า? ข้อมูลเดิมจะยังคงอยู่"
                                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-srt-navy hover:text-srt-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-srt-navy focus-visible:ring-offset-2">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                            ย้อนกลับขั้นก่อนหน้า
                        </button>
                    </form>
                </div>
            }

            @if (c.AcceptanceEvidence.FirstOrDefault() is { } evidence)
            {
                <details class="mt-4 rounded-xl border border-gray-200 bg-gray-50 p-4">
                    <summary class="cursor-pointer text-sm font-semibold text-gray-800">หลักฐานการยอมรับเงื่อนไขของผู้ร้อง</summary>
                    <dl class="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-600 sm:grid-cols-2">
                        <div><dt class="font-medium text-gray-800">เลขหลักฐาน</dt><dd class="font-mono break-all">@evidence.EvidenceId</dd></div>
                        <div><dt class="font-medium text-gray-800">ยอมรับเมื่อ</dt><dd>@evidence.AcceptedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd></div>
                        <div><dt class="font-medium text-gray-800">เวอร์ชัน</dt><dd class="break-all">@evidence.TermsVersion</dd></div>
                        <div><dt class="font-medium text-gray-800">แหล่งที่มา</dt><dd>@evidence.Source</dd></div>
                    </dl>
                </details>
            }
        </section>

        <!-- ══ Two-column layout ══ -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

            <!-- ── Left: Complaint details + timeline ── -->
            <div class="xl:col-span-2 space-y-5">

                <!-- Complaint Info -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                    <h2 class="text-sm font-semibold text-gray-900 mb-4">ข้อมูลเรื่องร้องเรียน</h2>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">ชื่อผู้ร้อง</dt>
                            <dd class="text-gray-900 mt-0.5">@c.ReporterName</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">เบอร์โทรศัพท์</dt>
                            <dd class="text-gray-900 mt-0.5 font-mono">@c.ReporterPhone</dd>
                        </div>
                        @if (!string.IsNullOrEmpty(c.ReporterEmail))
                        {
                            <div>
                                <dt class="text-xs text-gray-500 font-medium">อีเมล</dt>
                                <dd class="text-gray-900 mt-0.5">@c.ReporterEmail</dd>
                            </div>
                        }
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">ประเภทเรื่อง</dt>
                            <dd class="text-gray-900 mt-0.5">@c.Category.Name</dd>
                        </div>
                        @if (c.SubCategory != null)
                        {
                            <div>
                                <dt class="text-xs text-gray-500 font-medium">หัวข้อย่อย</dt>
                                <dd class="text-gray-900 mt-0.5">@c.SubCategory.Name</dd>
                            </div>
                        }
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">ฝ่ายรับผิดชอบ</dt>
                            <dd class="text-gray-900 mt-0.5">@(c.ResponsibleDepartment ?? c.Category.DepartmentName ?? "ยังไม่ระบุ")</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">วัตถุประสงค์การแจ้งเรื่อง</dt>
                            <dd class="text-gray-900 mt-0.5">@ComplaintSubmissionPurposes.Label(c.SubmissionPurpose)</dd>
                        </div>
                        @if (!string.IsNullOrEmpty(c.SubjectStation))
                        {
                            <div>
                                <dt class="text-xs text-gray-500 font-medium">สถานี / จุดที่เกิดเหตุ</dt>
                                <dd class="text-gray-900 mt-0.5">@c.SubjectStation</dd>
                            </div>
                        }
                        @if (c.IncidentDate.HasValue)
                        {
                            <div>
                                <dt class="text-xs text-gray-500 font-medium">วันที่เกิดเหตุ</dt>
                                <dd class="text-gray-900 mt-0.5">@c.IncidentDate.Value.ToString("dd/MM/yyyy")</dd>
                            </div>
                        }
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">SLA Deadline</dt>
                            <dd class="mt-0.5 @(slaBreached ? "text-red-600 font-medium" : "text-gray-900")">
                                @(c.SlaDeadline.HasValue ? c.SlaDeadline.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")
                                @if (slaBreached)
                                {
                                    <span class="ml-1">⚠</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500 font-medium">ผู้รับผิดชอบ</dt>
                            <dd class="text-gray-900 mt-0.5">@(c.AssignedTo?.FullName ?? "ยังไม่ได้รับมอบหมาย")</dd>
                        </div>
                    </dl>

                    <div class="mt-4 pt-4 border-t border-gray-100">
                        <dt class="text-xs text-gray-500 font-medium mb-1.5">รายละเอียดเรื่องร้องเรียน</dt>
                        <dd class="text-gray-800 text-sm leading-relaxed bg-gray-50 rounded-lg p-3 whitespace-pre-wrap">
                            @c.Description</dd>
                        </div>
                    </div>

                    <!-- Attachments -->
                    @using System.IO

@if (c.Attachments.Any())
{
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h2 class="text-sm font-semibold text-gray-900 mb-4">
            ไฟล์แนบ (@c.Attachments.Count)
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

            @foreach (var att in c.Attachments)
            {
                var fileUrl = Url.Page("CaseDetail", "Attachment", new { id = c.Id, attachmentId = att.Id });

                bool isImage = att.MimeType?.StartsWith("image/") == true;
                bool isPdf = att.MimeType == "application/pdf";

                <div class="border rounded-lg overflow-hidden bg-white shadow-sm">

                    @if (isImage)
                    {
                        <a href="@fileUrl" target="_blank">
                            <img src="@fileUrl"
                                 class="w-full h-48 object-cover hover:opacity-90 transition" />
                        </a>
                    }
                    else if (isPdf)
                    {
                        <div class="h-48 flex flex-col items-center justify-center bg-red-50">
                            <svg class="w-16 h-16 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/>
                            </svg>

                            <span class="text-red-600 font-semibold mt-2">
                                PDF
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="h-48 flex flex-col items-center justify-center bg-gray-100">
                            <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M7 7V3h10v4m-5 4v10m-5-5h10"/>
                            </svg>

                            <span class="text-gray-500 mt-2">
                                File
                            </span>
                        </div>
                    }

                    <div class="p-3">

                        <div class="font-medium text-sm truncate">
                            @att.FileName
                        </div>

                        <div class="text-xs text-gray-500 mb-3">
                            @String.Format("{0:N0} KB", (att.FileSize ?? 0) / 1024.0)
                        </div>

                        @if (isImage)
                        {
                            <a href="@fileUrl"
                               target="_blank"
                               class="inline-flex items-center text-sm text-blue-600 hover:underline">
                                ดูภาพเต็ม
                            </a>
                        }
                        else if (isPdf)
                        {
                            <div class="flex gap-2">

                                <a href="@fileUrl"
                                   target="_blank"
                                   class="px-3 py-1 rounded bg-blue-600 text-white text-xs hover:bg-blue-700">
                                    Preview
                                </a>

                                <a href="@fileUrl"
                                   download
                                   class="px-3 py-1 rounded border text-xs hover:bg-gray-50">
                                    Download
                                </a>

                            </div>
                        }
                        else
                        {
                            <a href="@fileUrl"
                               download
                               class="inline-flex items-center text-sm text-blue-600 hover:underline">
                                Download
                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    </div>
}

                    <!-- Timeline / Notes -->
                    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                        <h2 class="text-sm font-semibold text-gray-900 mb-4">ประวัติและบันทึก</h2>

                        @if (!c.Notes.Any() && !c.TransferLogs.Any())
                        {
                            <p class="text-sm text-gray-400 text-center py-6">ยังไม่มีบันทึก</p>
                        }

                        <div class="space-y-4">
                            @foreach (var note in c.Notes.OrderByDescending(n => n.CreatedAt))
                            {
                                var isReporterReply = note.NoteType == "ReporterReply";
                                var noteAuthorName = isReporterReply ? "ผู้ร้องเรียน" : note.Author?.FullName ?? "ระบบ";
                                var noteTypeLabel = note.NoteType switch
                                {
                                    "PublicReply" => "ตอบกลับผู้ร้อง",
                                    "InfoRequest" => "ขอข้อมูลเพิ่ม",
                                    "ReporterReply" => "ข้อมูลจากผู้ร้อง",
                                    "Workflow" => "Workflow",
                                    "StatusChange" => "เปลี่ยนสถานะ",
                                    _ => "บันทึกภายใน"
                                };
                                <div class="flex gap-3">
                                    <div
                                        class="w-8 h-8 rounded-full bg-srt-navy/10 flex items-center justify-center text-xs font-semibold text-srt-navy shrink-0 mt-0.5">
                                        @(isReporterReply ? "ผ" : note.Author?.FullName?.Split(' ').FirstOrDefault()?.FirstOrDefault() ?? '?')
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-sm font-medium text-gray-900">@noteAuthorName</span>
                                            <span
                                                class="px-1.5 py-0.5 rounded text-[10px] font-medium
                                                @(isReporterReply ? "bg-teal-100 text-teal-800" : note.NoteType is "PublicReply" or "InfoRequest" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                                @noteTypeLabel
                                            </span>
                                            <span class="text-xs text-gray-400 ml-auto">@note.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                                        </div>
                                        <p class="text-sm text-gray-700 bg-gray-50 rounded-lg px-3 py-2 whitespace-pre-wrap">
                                            @note.Content</p>
                                        @if (note.Attachments.Any())
                                        {
                                            <div class="flex flex-wrap gap-2 mt-2">
                                                @foreach (var att in note.Attachments)
                                                {
                                                    var attUrl = Url.Page("CaseDetail", "Attachment", new { id = c.Id, attachmentId = att.Id });
                                                    bool isImg = att.MimeType?.StartsWith("image/") == true;
                                                    <a href="@attUrl" target="_blank"
                                                       class="flex items-center gap-1.5 text-xs px-2 py-1 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 transition">
                                                        @if (isImg)
                                                        {
                                                            <img src="@attUrl" class="w-5 h-5 rounded object-cover" alt="" />
                                                        }
                                                        else
                                                        {
                                                            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                            </svg>
                                                        }
                                                        <span class="truncate max-w-[100px]">@att.FileName</span>
                                                    </a>
                                                }
                                            </div>
                                        }
                                        </div>
                                    </div>
                                }

                                @foreach (var transfer in c.TransferLogs.OrderByDescending(t => t.TransferredAt))
                                {
                                    <div class="flex gap-3">
                                        <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center shrink-0 mt-0.5">
                                            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                                 aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                                            </svg>
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm text-gray-700">
                                                โอนเรื่องไปยัง <strong>@(transfer.ToOfficer?.FullName ?? "—")</strong>
                                                @if (transfer.FromOfficer != null)
                                                {
                                                    <span> จาก @transfer.FromOfficer.FullName</span>
                                                }
                                            </p>
                                            <p class="text-xs text-gray-500 mt-0.5">เหตุผล: @transfer.Reason</p>
                                            <p class="text-xs text-gray-400 mt-0.5">@transfer.TransferredAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- ── Right: Action Panel ── -->
                    <div class="space-y-4">

                        <!-- Edit complaint classification -->
                        @if (canModify && c.WorkflowStep != ComplaintWorkflowSteps.Classification)
                        {
                            <div id="classification-panel" class="scroll-mt-24 bg-white rounded-xl border border-gray-200 shadow-sm p-4">
                                <h3 class="text-sm font-semibold text-gray-900">แก้ไขประเภทและฝ่ายรับผิดชอบ</h3>
                                <p class="mt-1 mb-3 text-xs text-gray-500">ใช้เมื่อผู้ร้องเลือกประเภทหรือฝ่ายไม่ถูกต้อง</p>
                                <form method="post" asp-page-handler="UpdateClassification" asp-route-id="@c.Id">
                                    @Html.AntiForgeryToken()
                                    <label for="classification-category" class="block text-xs font-medium text-gray-700 mb-1">ประเภทเรื่อง</label>
                                    <select id="classification-category" name="ClassificationCategoryId" required
                                            class="form-select-compact min-h-11 mb-3">
                                        @foreach (var category in Model.ClassificationCategoryOptions)
                                        {
                                            <option value="@category.Value" selected="@(category.Value == Model.ClassificationCategoryId.ToString())">@category.Text</option>
                                        }
                                    </select>

                                    <div id="classification-subcategory-wrapper" class="mb-3">
                                        <label for="classification-subcategory" class="block text-xs font-medium text-gray-700 mb-1">หัวข้อย่อย</label>
                                        <select id="classification-subcategory" name="ClassificationSubCategoryId"
                                                class="form-select-compact min-h-11"></select>
                                    </div>

                                    <label for="classification-department" class="block text-xs font-medium text-gray-700 mb-1">ฝ่ายรับผิดชอบ</label>
                                    <select id="classification-department" name="ClassificationDepartment"
                                            class="form-select-compact min-h-11 mb-3">
                                        <option value="">— ใช้ฝ่ายตามประเภทเรื่อง —</option>
                                        @foreach (var department in Model.ClassificationDepartmentOptions)
                                        {
                                            <option value="@department" selected="@(department == Model.ClassificationDepartment)">@department</option>
                                        }
                                    </select>

                                    <button type="submit" class="w-full min-h-11 border border-srt-navy text-srt-navy text-sm font-medium py-2 rounded-lg
                                        hover:bg-srt-navy hover:text-white focus:outline-none focus:ring-2 focus:ring-srt-navy focus:ring-offset-2 transition">
                                        บันทึกการแก้ไข
                                    </button>
                                </form>
                            </div>
                        }

                        <!-- eDOC -->
                        @if (Model.EdocEnabled || Model.EdocLink != null)
                        {
                            <div class="bg-white rounded-xl border border-blue-200 shadow-sm p-4">
                                <div class="flex items-start justify-between gap-3 mb-3">
                                    <div>
                                        <h3 class="text-sm font-semibold text-gray-900">เอกสาร eDOC</h3>
                                        <p class="text-xs text-gray-500 mt-1">ระบบจะใช้บัญชีบริการส่งให้โดยอัตโนมัติ ไม่ต้องเข้าสู่ระบบ eDOC</p>
                                    </div>
                                    @if (Model.EdocLink != null)
                                    {
                                        <span class="inline-flex shrink-0 rounded-full border px-2 py-1 text-xs font-medium @EdocStatusColor(Model.EdocLink.SyncStatus)">
                                            @EdocStatusLabel(Model.EdocLink.SyncStatus)
                                        </span>
                                    }
                                </div>

                                @if (Model.EdocLink == null)
                                {
                                    @if (canModify && Model.EdocEnabled)
                                    {
                                        <form method="post" asp-page-handler="SendToEdoc" asp-route-id="@c.Id"
                                              onsubmit="const b=this.querySelector('button[type=submit]');b.disabled=true;b.textContent='กำลังสร้างเอกสาร...';">
                                            @Html.AntiForgeryToken()
                                            <label for="edoc-basket" class="block text-xs font-medium text-gray-700 mb-1">ฝ่าย/สำนักงาน (Basket)</label>
                                            <select id="edoc-basket" name="EdocBasketId" required class="form-select-compact min-h-11 mb-3">
                                                @foreach (var basket in Model.EdocBaskets)
                                                {
                                                    <option value="@basket.Id" selected="@(basket.Id == Model.DefaultEdocBasketId)">@basket.Name (@basket.Id)</option>
                                                }
                                            </select>
                                            <button type="submit"
                                                    class="w-full min-h-11 bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-blue-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-60 transition"
                                                    data-confirm="ยืนยันสร้างเอกสารใน eDOC สำหรับ Basket ที่เลือก?">
                                                สร้างเอกสาร eDOC
                                            </button>
                                        </form>
                                    }
                                    else if (!Model.EdocEnabled)
                                    {
                                        <p class="text-sm text-amber-700 bg-amber-50 rounded-lg p-3">ยังไม่ได้เปิดใช้งานการเชื่อมต่อ eDOC</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-gray-500">เฉพาะผู้รับผิดชอบเรื่องหรือผู้ดูแลระบบเท่านั้นที่สร้างเอกสารได้</p>
                                    }
                                }
                                else
                                {
                                    var edoc = Model.EdocLink;
                                    <dl class="space-y-2 text-xs">
                                        <div class="flex justify-between gap-3"><dt class="text-gray-500">Basket</dt><dd class="text-right font-medium text-gray-800">@(edoc.BasketName ?? "-")<br /><span class="font-mono text-gray-500">@edoc.BasketId</span></dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-gray-500">WID</dt><dd class="font-mono text-right text-gray-800 break-all">@edoc.WID</dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-gray-500">เลขทะเบียน</dt><dd class="font-medium text-right text-gray-800">@(edoc.RegisterNumber ?? "รอข้อมูลจาก eDOC")</dd></div>
                                        @if (!string.IsNullOrWhiteSpace(edoc.RemoteStatusDescription))
                                        {
                                            <div class="flex justify-between gap-3"><dt class="text-gray-500">สถานะ eDOC</dt><dd class="text-right text-gray-800">@edoc.RemoteStatusDescription</dd></div>
                                        }
                                    </dl>

                                    @if (!string.IsNullOrWhiteSpace(edoc.LastError))
                                    {
                                        <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">@edoc.LastError</div>
                                    }

                                    @if (canModify && Model.EdocEnabled)
                                    {
                                        <div class="grid grid-cols-1 gap-2 mt-3">
                                            @if (edoc.SyncStatus is "Sent" or "SentWithAttachmentErrors")
                                            {
                                                <form method="post" asp-page-handler="TrackEdoc" asp-route-id="@c.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="w-full min-h-11 border border-blue-300 text-blue-700 text-sm font-medium px-3 py-2 rounded-lg hover:bg-blue-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 transition">ตรวจสอบสถานะ eDOC</button>
                                                </form>
                                            }
                                            @if (edoc.SyncStatus == "NeedsReview")
                                            {
                                                <form method="post" asp-page-handler="ReconcileEdoc" asp-route-id="@c.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="w-full min-h-11 border border-amber-300 text-amber-800 text-sm font-medium px-3 py-2 rounded-lg hover:bg-amber-50 transition">ตรวจสอบว่ามีเอกสารแล้วหรือยัง</button>
                                                </form>
                                            }
                                            @if (User.IsInRole("SuperAdmin") && edoc.SyncStatus is "Failed" or "NeedsReview")
                                            {
                                                <form method="post" asp-page-handler="RetryEdoc" asp-route-id="@c.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" data-confirm="ยืนยันส่งเอกสาร eDOC ใหม่? ควรตรวจสอบสถานะก่อนเพื่อป้องกันเอกสารซ้ำ"
                                                            class="w-full min-h-11 border border-red-300 text-red-700 text-sm font-medium px-3 py-2 rounded-lg hover:bg-red-50 transition">ส่งใหม่ (ผู้ดูแลระบบ)</button>
                                                </form>
                                            }
                                            @if (User.IsInRole("SuperAdmin") && edoc.SyncStatus == "SentWithAttachmentErrors")
                                            {
                                                <form method="post" asp-page-handler="RetryEdocAttachments" asp-route-id="@c.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" data-confirm="ยืนยันส่งไฟล์แนบที่มีปัญหาใหม่?"
                                                            class="w-full min-h-11 border border-amber-300 text-amber-800 text-sm font-medium px-3 py-2 rounded-lg hover:bg-amber-50 transition">ส่งไฟล์แนบใหม่ (ผู้ดูแลระบบ)</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- Add Note -->
                        @if (!isClosed)
                        {
                            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
                                <h3 class="text-sm font-semibold text-gray-900 mb-3">เพิ่มบันทึก</h3>
                                <form method="post" asp-page-handler="AddNote" asp-route-id="@c.Id" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <div class="flex gap-2 mb-3">
                                        <label class="flex items-center gap-1.5 text-xs text-gray-600 cursor-pointer">
                                            <input type="radio" name="NoteType" value="InternalNote" checked class="accent-srt-navy" />
                                            บันทึกภายใน
                                        </label>
                                        <label class="flex items-center gap-1.5 text-xs text-gray-600 cursor-pointer">
                                            <input type="radio" name="NoteType" value="PublicReply" class="accent-srt-navy" />
                                            ตอบกลับผู้ร้อง
                                        </label>
                                    </div>
                                    <textarea name="NoteContent" rows="3" placeholder="กรอกบันทึก..." class="form-textarea-compact mb-2"></textarea>
                                    <label class="block text-xs text-gray-500 mb-1">
                                        แนบรูป/ไฟล์ <span class="text-gray-400">(ถ้ามี — จะแสดงให้ผู้ร้องเห็นด้วยถ้าเลือก "ตอบกลับผู้ร้อง")</span>
                                    </label>
                                    <input type="file" name="NoteAttachments" multiple
                                           accept=".jpg,.jpeg,.png,.pdf,.doc,.docx"
                                           class="file-input mb-3" />
                                    <button type="submit" class="w-full border border-gray-300 text-gray-700 text-sm font-medium py-2 rounded-lg
                                        hover:bg-gray-50 transition">
                                        บันทึก
                                    </button>
                                </form>
                            </div>
                        }

                        <!-- Transfer -->
                        @if (!isClosed && c.AssignedToId.HasValue && Model.StaffOptions.Any())
                        {
                            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
                                <h3 class="text-sm font-semibold text-gray-900 mb-3">โอนเรื่อง</h3>
                                <form method="post" asp-page-handler="Transfer" asp-route-id="@c.Id">
                                    @Html.AntiForgeryToken()
                                    <select name="TransferToId" class="form-select-compact mb-2">
                                        <option value="">— เลือกผู้รับโอน —</option>
                                        @foreach (var s in Model.StaffOptions)
                                        {
                                            <option value="@s.Value">@s.Text</option>
                                        }
                                    </select>
                                    <input type="text" name="TransferReason" placeholder="เหตุผลในการโอน..." class="form-input-compact mb-3" />
                                    <button type="submit" class="w-full border border-gray-300 text-gray-700 text-sm font-medium py-2 rounded-lg
                                        hover:bg-gray-50 transition">
                                        โอนเรื่อง
                                    </button>
                                </form>
                            </div>
                        }

                        <!-- Closed state info -->
                        @if (isClosed)
                        {
                            <div class="bg-gray-50 rounded-xl border border-gray-200 p-4 text-center">
                                <svg class="w-8 h-8 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="text-sm text-gray-500">เรื่องนี้ปิดแล้ว</p>
                                @if (c.ClosedAt.HasValue)
                                {
                                    <p class="text-xs text-gray-400 mt-1">@c.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                @if (c.Status == "Closed")
                                {
                                    <form method="post" asp-page-handler="Reopen" asp-route-id="@c.Id" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" data-confirm="เปิดเรื่องนี้ใหม่อีกครั้ง?" class="inline-flex items-center gap-1.5 text-xs text-amber-700 border border-amber-300
                                            bg-amber-50 px-3 py-1.5 rounded-lg hover:bg-amber-100 transition">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                            เปิดเรื่องใหม่
                                        </button>
                                    </form>
                                }
                            </div>
                        }

                    </div>
                </div>

@section Scripts {
    <script>
        (function () {
            const category = document.getElementById('classification-category');
            const subcategory = document.getElementById('classification-subcategory');
            const wrapper = document.getElementById('classification-subcategory-wrapper');
            const department = document.getElementById('classification-department');
            if (!category || !subcategory || !wrapper) return;

            const allSubcategories = @Html.Raw(Model.ClassificationSubCategoriesJson);
            const departmentsByCategory = @Html.Raw(Model.ClassificationDepartmentsByCategoryJson);
            const initialSubcategory = '@(Model.ClassificationSubCategoryId)';

            function refreshSubcategories(keepInitial) {
                const items = allSubcategories[category.value] || [];
                subcategory.replaceChildren();

                const empty = document.createElement('option');
                empty.value = '';
                empty.textContent = '— ไม่ระบุหัวข้อย่อย —';
                subcategory.appendChild(empty);

                items.forEach(function (item) {
                    const option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.name;
                    if (keepInitial && String(item.id) === initialSubcategory) option.selected = true;
                    subcategory.appendChild(option);
                });

                wrapper.classList.toggle('hidden', items.length === 0);
            }

            category.addEventListener('change', function () {
                refreshSubcategories(false);
                if (department) department.value = departmentsByCategory[category.value] || '';
            });
            refreshSubcategories(true);
        })();

        (function () {
            const form = document.getElementById('close-case-form');
            const opening = document.getElementById('close-opening');
            const resolution = document.getElementById('close-resolution');
            const preview = document.getElementById('close-summary-preview');
            const previewText = document.getElementById('close-summary-preview-text');
            const submit = document.getElementById('close-case-submit');
            if (!form || !opening || !resolution || !preview || !previewText || !submit) return;

            function updatePreview() {
                const openingText = opening.value ? opening.options[opening.selectedIndex].text : '';
                const detailText = resolution.value.trim();
                const hasCompleteSummary = openingText && detailText;
                preview.classList.toggle('hidden', !hasCompleteSummary);
                previewText.textContent = hasCompleteSummary ? `${openingText} ${detailText}` : '';
            }

            opening.addEventListener('change', updatePreview);
            resolution.addEventListener('input', updatePreview);
            form.dataset.confirm = 'ยืนยันบันทึกสรุปผลและปิดงานนี้? ผู้ร้องจะเห็นข้อความที่แสดงในตัวอย่าง';
        })();
    </script>
}
